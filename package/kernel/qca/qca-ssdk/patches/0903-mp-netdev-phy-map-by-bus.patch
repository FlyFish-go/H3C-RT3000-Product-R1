+#ifdef MP
+/*
+ * Map only PHYs explicitly represented by the SSDK port configuration.
+ * The legacy address-only mapper is still used by unrelated SSDK callers,
+ * but cannot distinguish identical addresses on separate MDIO buses.
+ */
+static int ssdk_mdio_bus_phy_to_configured_port(struct qca_phy_priv *priv,
+		struct mii_bus *bus, a_uint32_t phy_addr, a_uint32_t *port_id)
+{
+	a_uint32_t i;
+	a_bool_t found = A_FALSE;
+	struct mii_bus *configured_bus;
+	ssdk_port_phyinfo *phyinfo;
+
+	if (!priv || !bus || !port_id || phy_addr >= PHY_MAX_ADDR)
+		return -ENODEV;
+
+	for (i = 0; i < SW_MAX_NR_PORT; i++) {
+		phyinfo = ssdk_port_phyinfo_get(priv->device_id, i);
+		if (!phyinfo || phyinfo->port_id != i ||
+			!(phyinfo->phy_features & PHY_F_INIT) ||
+			(phyinfo->phy_features & PHY_F_I2C) ||
+			phyinfo->phy_addr != phy_addr)
+			continue;
+
+		configured_bus = phyinfo->notify_miibus;
+		if (!configured_bus && phyinfo->notify_miibus_is_default)
+			configured_bus = priv->miibus;
+		if (!configured_bus || configured_bus != bus)
+			continue;
+
+		if (found)
+			return -EEXIST;
+
+		*port_id = i;
+		found = A_TRUE;
+	}
+
+	return found ? 0 : -ENODEV;
+}
+#endif
+
