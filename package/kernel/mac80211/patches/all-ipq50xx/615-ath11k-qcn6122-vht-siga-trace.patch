+/* SPDX-License-Identifier: BSD-3-Clause-Clear */
+#ifndef ATH11K_QCN6122_VHT_SIGA_TRACE_POLICY_H
+#define ATH11K_QCN6122_VHT_SIGA_TRACE_POLICY_H
+
+/* Require a PPDU_START on this same MAC and one record per PPDU. */
+static inline bool ath11k_qcn6122_vht_siga_trace_claim(bool c_board,
+		bool qcn6122, bool ppdu_valid, bool already_logged,
+		u8 start_mac_id, u8 current_mac_id)
+{
+	return c_board && qcn6122 && ppdu_valid && !already_logged &&
+	       start_mac_id == current_mac_id;
+}
+
+#endif
