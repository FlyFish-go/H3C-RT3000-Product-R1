+#include "qcn6122_vht_siga_trace_policy.h"
+
+static bool ath11k_qcn6122_vht_siga_trace_enable;
+static atomic_t ath11k_qcn6122_vht_siga_trace_remaining = ATOMIC_INIT(16);
+
+static int ath11k_qcn6122_vht_siga_trace_set(const char *val,
+					     const struct kernel_param *kp)
+{
+	bool enable;
+	int ret;
+
+	ret = kstrtobool(val, &enable);
+	if (ret)
+		return ret;
+	if (enable)
+		atomic_set(&ath11k_qcn6122_vht_siga_trace_remaining, 16);
+	WRITE_ONCE(*(bool *)kp->arg, enable);
+	return 0;
+}
+
+static const struct kernel_param_ops ath11k_qcn6122_vht_siga_trace_ops = {
+	.set = ath11k_qcn6122_vht_siga_trace_set,
+	.get = param_get_bool,
+};
+module_param_cb(qcn6122_vht_siga_trace,
+		&ath11k_qcn6122_vht_siga_trace_ops,
+		&ath11k_qcn6122_vht_siga_trace_enable, 0600);
+MODULE_PARM_DESC(qcn6122_vht_siga_trace,
+		 "Log at most 16 C/QCN6122 VHT SIG-A status samples");
+
+static void ath11k_qcn6122_vht_siga_trace(struct ath11k_base *ab,
+					 struct hal_rx_mon_ppdu_info *ppdu_info,
+					 int mac_id, u32 info0)
+{
+	int remaining;
+	u8 bw;
+
+	if (!READ_ONCE(ath11k_qcn6122_vht_siga_trace_enable) ||
+	    !ath11k_qcn6122_vht_siga_trace_claim(
+		of_machine_is_compatible("h3c,rt3000-rtl8367s"),
+		ab->hw_params.hw_rev == ATH11K_HW_QCN6122,
+		ppdu_info->qcn6122_vht_siga_ppdu_valid,
+		ppdu_info->qcn6122_vht_siga_logged,
+		ppdu_info->qcn6122_vht_siga_mac_id, mac_id))
+		return;
+
+	remaining = atomic_dec_if_positive(
+		&ath11k_qcn6122_vht_siga_trace_remaining);
+	if (remaining < 0) {
+		WRITE_ONCE(ath11k_qcn6122_vht_siga_trace_enable, false);
+		return;
+	}
+
+	ppdu_info->qcn6122_vht_siga_logged = true;
+	bw = FIELD_GET(HAL_RX_VHT_SIG_A_INFO_INFO0_BW, info0);
+	dev_info(ab->dev,
+		 "qcn6122-vht-siga-615 sample=%u mac=%d ppdu=%u chan=%u raw_info0=0x%08x siga_bw=%u\n",
+		 16 - remaining, mac_id, ppdu_info->ppdu_id,
+		 ppdu_info->chan_num, info0, bw);
+	if (!remaining)
+		WRITE_ONCE(ath11k_qcn6122_vht_siga_trace_enable, false);
+}
 
