+#ifdef CPTCFG_ATH11K_RT3000_REO_IDR_CLAIM
+static bool ath11k_dp_rx_reo_idr_claim_enabled(struct ath11k_base *ab)
+{
+	return ab->hw_params.hw_rev == ATH11K_HW_IPQ5018 &&
+	       ab->dp.reo_pending_msdu;
+}
+
+static struct sk_buff_head *
+ath11k_dp_rx_reo_pending_queue(struct ath11k_dp *dp, int ring_id, int mac_id)
+{
+	return &dp->reo_pending_msdu[ring_id * MAX_RADIOS + mac_id];
+}
+
+static int ath11k_dp_rx_reo_take_complete_prefix(struct sk_buff_head *pending,
+						 struct sk_buff_head *ready)
+{
+	struct ath11k_skb_rxcb *rxcb;
+	struct sk_buff *skb;
+	unsigned long flags;
+	int n = 0, last_complete = 0, complete = 0, i;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	skb_queue_walk(pending, skb) {
+		n++;
+		rxcb = ATH11K_SKB_RXCB(skb);
+		if (!rxcb->is_continuation) {
+			last_complete = n;
+			complete++;
+		}
+	}
+	for (i = 0; i < last_complete; i++)
+		__skb_queue_tail(ready, __skb_dequeue(pending));
+	spin_unlock_irqrestore(&pending->lock, flags);
+	return complete;
+}
