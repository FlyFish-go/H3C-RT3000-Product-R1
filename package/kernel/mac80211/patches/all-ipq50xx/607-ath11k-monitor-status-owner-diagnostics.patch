+config ATH11K_RT3000_MON_OWNER_DIAG
+	bool "RT3000 ath11k monitor-status owner diagnostics"
+	depends on ATH11K
+	default n
+	help
+	  Keep bounded per-buffer ownership and lifecycle history for ath11k
+	  monitor-status RX rings. Intended for opt-in RT3000 C diagnostics.
+	  Uses 444 KiB per 512-entry status ring on 32-bit ARM (two C radios: 888 KiB).
+	  History is per buffer, is frozen at first mismatch, and emits
+	  history only when a DMA metadata mismatch is detected.
+
 config ATH11K_DEBUG
 	bool "QCA ath11k debugging"
 	depends on ATH11K
