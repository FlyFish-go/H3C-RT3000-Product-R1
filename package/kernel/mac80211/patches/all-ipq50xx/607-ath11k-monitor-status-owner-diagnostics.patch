+#ifdef CPTCFG_ATH11K_RT3000_MON_OWNER_DIAG
+static DEFINE_RATELIMIT_STATE(ath11k_mon_owner_ratelimit,
+			      DEFAULT_RATELIMIT_INTERVAL,
+			      DEFAULT_RATELIMIT_BURST);
+static atomic_t ath11k_mon_owner_first_fault = ATOMIC_INIT(0);
+
+static void ath11k_mon_owner_event_locked(struct dp_rxdma_ring *rx_ring,
+					  int buf_id, u8 state,
+					  struct sk_buff *skb,
+					  dma_addr_t observed_paddr,
+					  u32 cookie)
+{
+	struct ath11k_mon_owner_record *owner;
+	struct ath11k_mon_owner_event *event;
+	u64 seq;
+
+	if (!rx_ring->mon_owner || buf_id < 0 || buf_id >= rx_ring->mon_owner_count)
+		return;
+	owner = &rx_ring->mon_owner[buf_id];
+	/* Freeze this generation's forensic history at its first mismatch. */
+	if (state != ATH11K_MON_OWNER_IDR_ALLOC && owner->mismatch_valid)
+		return;
+	if (state == ATH11K_MON_OWNER_IDR_ALLOC) {
+		owner->generation++;
+		owner->skb = (unsigned long)skb;
+		owner->paddr = observed_paddr;
+		owner->len = skb->len + skb_tailroom(skb);
+		owner->cookie = 0;
+		owner->history_head = 0;
+		owner->history_count = 0;
+		owner->mismatch_valid = false;
+		owner->mismatch_logged = false;
+	} else if (skb && !owner->skb) {
+		owner->skb = (unsigned long)skb;
+	}
+	if (cookie)
+		owner->cookie = cookie;
+	owner->state = state;
+	seq = ++rx_ring->mon_owner_seq;
+	event = &owner->history[owner->history_head];
+	event->seq = seq;
+	event->observed_paddr = observed_paddr;
+	event->cookie = cookie ? cookie : owner->cookie;
+	event->generation = owner->generation;
+	event->state = state;
+	owner->history_head = (owner->history_head + 1) % ATH11K_MON_OWNER_HISTORY_SIZE;
+	if (owner->history_count < ATH11K_MON_OWNER_HISTORY_SIZE)
+		owner->history_count++;
+}
+
+static void ath11k_mon_owner_diag_mismatch(struct ath11k_base *ab,
+					   struct hal_srng *srng,
+					   struct dp_rxdma_ring *rx_ring,
+					   int mac_id, int buf_id,
+					   struct sk_buff *skb,
+					   dma_addr_t desc_paddr,
+					   dma_addr_t cb_paddr,
+					   u32 cookie)
+{
+	struct ath11k_mon_owner_event history[ATH11K_MON_OWNER_HISTORY_SIZE];
+	struct ath11k_mon_owner_snapshot snapshot = {};
+	struct ath11k_mon_owner_record *owner;
+	struct ath11k_mon_owner_event *event;
+	struct sk_buff *idr_skb;
+	void *current_desc, *adjacent_desc;
+	dma_addr_t current_paddr = 0, adjacent_paddr = 0;
+	u32 current_cookie = 0, adjacent_cookie = 0;
+	u8 rbm;
+	u32 hp_idx = 0, adjacent_idx = 0;
+	int i, n = 0, start;
+	bool emit = false, allow_emit;
+
+	lockdep_assert_held(&srng->lock);
+	if (!rx_ring->mon_owner)
+		return;
+	current_desc = ath11k_hal_srng_src_peek(ab, srng);
+	adjacent_desc = ath11k_hal_srng_src_next_peek(ab, srng);
+	if (current_desc)
+		ath11k_hal_rx_buf_addr_info_get(current_desc, &current_paddr, &current_cookie, &rbm);
+	if (adjacent_desc)
+		ath11k_hal_rx_buf_addr_info_get(adjacent_desc, &adjacent_paddr, &adjacent_cookie, &rbm);
+	if (srng->entry_size && srng->ring_size) {
+		hp_idx = srng->u.src_ring.hp / srng->entry_size;
+		adjacent_idx = ((srng->u.src_ring.hp + srng->entry_size) %
+				 srng->ring_size) / srng->entry_size;
+	}
+	/* Preserve one global first-fault record, then rate-limit all output. */
+	allow_emit = false;
+	if (buf_id >= 0 && buf_id < rx_ring->mon_owner_count &&
+	    atomic_cmpxchg(&ath11k_mon_owner_first_fault, 0, 1) == 0)
+		allow_emit = true;
+	else
+		allow_emit = __ratelimit(&ath11k_mon_owner_ratelimit);
+	/* Lock order is SRNG (caller) then IDR; copy scalars before unlocking. */
+	spin_lock_bh(&rx_ring->idr_lock);
+	if (buf_id >= 0 && buf_id < rx_ring->mon_owner_count) {
+		owner = &rx_ring->mon_owner[buf_id];
+		idr_skb = idr_find(&rx_ring->bufs_idr, buf_id);
+		if (!owner->mismatch_valid) {
+			/* cb_paddr was sampled by the caller before this IDR lock. */
+			owner->mismatch.desc_paddr = desc_paddr;
+			owner->mismatch.cb_paddr = cb_paddr;
+			owner->mismatch.current_paddr = current_paddr;
+			owner->mismatch.adjacent_paddr = adjacent_paddr;
+			owner->mismatch.owner_paddr = owner->paddr;
+			owner->mismatch.desc_cookie = cookie;
+			owner->mismatch.current_cookie = current_cookie;
+			owner->mismatch.adjacent_cookie = adjacent_cookie;
+			owner->mismatch.owner_cookie = owner->cookie;
+			owner->mismatch.owner_len = owner->len;
+			owner->mismatch.generation = owner->generation;
+			owner->mismatch.hp_idx = hp_idx;
+			owner->mismatch.adjacent_idx = adjacent_idx;
+			owner->mismatch.owner_state = owner->state;
+			owner->mismatch.idr_present = !!idr_skb;
+			owner->mismatch.idr_same = idr_skb == skb;
+			owner->mismatch.owner_same = owner->skb == (unsigned long)skb;
+		}
+	}
+	ath11k_mon_owner_event_locked(rx_ring, buf_id, ATH11K_MON_OWNER_MISMATCH,
+				      skb, desc_paddr, cookie);
+	if (buf_id >= 0 && buf_id < rx_ring->mon_owner_count) {
+		owner = &rx_ring->mon_owner[buf_id];
+		if (!owner->mismatch_valid) {
+			owner->mismatch.seq = rx_ring->mon_owner_seq;
+			owner->mismatch_valid = true;
+		}
+		if (!owner->mismatch_logged && allow_emit) {
+			snapshot = owner->mismatch;
+			start = (owner->history_head + ATH11K_MON_OWNER_HISTORY_SIZE -
+				 owner->history_count) % ATH11K_MON_OWNER_HISTORY_SIZE;
+			for (i = 0; i < owner->history_count; i++) {
+				event = &owner->history[(start + i) % ATH11K_MON_OWNER_HISTORY_SIZE];
+				if (event->generation == snapshot.generation)
+					history[n++] = *event;
+			}
+			owner->mismatch_logged = true;
+			emit = true;
+		}
+	}
+	spin_unlock_bh(&rx_ring->idr_lock);
+	if (!emit)
+		return;
+	dev_warn(ab->dev,
+		 "mon-owner mismatch first=1 (mon-owner first-mismatch) mac=%d ring=%u hp_idx=%u desc=%pad cookie=0x%x current=%pad current_cookie=0x%x adj_idx=%u adjacent=%pad adjacent_cookie=0x%x buf_id=%d idr_present=%u idr_same=%u owner_same=%u cb=%pad owner_paddr=%pad owner_cookie=0x%x len=%u gen=%u state=%u seq=%llu\n",
+		 mac_id, srng->ring_id, snapshot.hp_idx, &snapshot.desc_paddr,
+		 snapshot.desc_cookie, &snapshot.current_paddr, snapshot.current_cookie,
+		 snapshot.adjacent_idx, &snapshot.adjacent_paddr,
+		 snapshot.adjacent_cookie, buf_id, snapshot.idr_present, snapshot.idr_same,
+		 snapshot.owner_same,
+		 &snapshot.cb_paddr, &snapshot.owner_paddr, snapshot.owner_cookie,
+		 snapshot.owner_len, snapshot.generation, snapshot.owner_state,
+		 (unsigned long long)snapshot.seq);
+	for (i = 0; i < n; i++)
+		dev_warn(ab->dev,
+			 "mon-owner hist mac=%d ring=%u buf_id=%d gen=%u snapshot_seq=%llu event_seq=%llu state=%u cookie=0x%x observed=%pad\n",
+			 mac_id, srng->ring_id, buf_id, history[i].generation,
+			 (unsigned long long)snapshot.seq,
+			 (unsigned long long)history[i].seq, history[i].state,
+			 history[i].cookie, &history[i].observed_paddr);
+}
+
+static void ath11k_mon_owner_record(struct dp_rxdma_ring *rx_ring,
+				    int buf_id, u8 state, struct sk_buff *skb,
+				    dma_addr_t paddr, u32 cookie)
+{
+	if (!rx_ring->mon_owner)
+		return;
+	spin_lock_bh(&rx_ring->idr_lock);
+	ath11k_mon_owner_event_locked(rx_ring, buf_id, state, skb, paddr, cookie);
+	spin_unlock_bh(&rx_ring->idr_lock);
+}
+
+static void ath11k_mon_owner_diag_free(struct dp_rxdma_ring *rx_ring)
+{
+	kvfree(rx_ring->mon_owner);
+	rx_ring->mon_owner = NULL;
+	rx_ring->mon_owner_count = 0;
+	rx_ring->mon_owner_seq = 0;
+}
+#else
+#define ath11k_mon_owner_event_locked(rx_ring, buf_id, state, skb, observed, cookie) do { } while (0)
+#define ath11k_mon_owner_diag_mismatch(ab, srng, ring, mac, id, skb, desc, cb, cookie) do { } while (0)
+#define ath11k_mon_owner_record(rx_ring, id, state, skb, paddr, cookie) do { } while (0)
+#define ath11k_mon_owner_diag_free(rx_ring) do { } while (0)
+#endif
+
