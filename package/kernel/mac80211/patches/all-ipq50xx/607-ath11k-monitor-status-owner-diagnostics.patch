+	ATH11K_MON_OWNER_REAP_LOOKUP,
+	ATH11K_MON_OWNER_IDR_REMOVE,
+	ATH11K_MON_OWNER_UNMAP,
+	ATH11K_MON_OWNER_TRANSFER,
