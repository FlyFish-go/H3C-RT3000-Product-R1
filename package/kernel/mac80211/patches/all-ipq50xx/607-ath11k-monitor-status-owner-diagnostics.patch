+struct ath11k_mon_owner_snapshot {
+	dma_addr_t desc_paddr;
+	dma_addr_t cb_paddr;
+	dma_addr_t current_paddr;
+	dma_addr_t adjacent_paddr;
+	dma_addr_t owner_paddr;
+	u64 seq;
+	u32 desc_cookie;
+	u32 current_cookie;
+	u32 adjacent_cookie;
+	u32 owner_cookie;
+	u32 owner_len;
