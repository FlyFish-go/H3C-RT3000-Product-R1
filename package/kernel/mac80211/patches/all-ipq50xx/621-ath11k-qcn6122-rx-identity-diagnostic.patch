+static bool ath11k_qcn6122_rx_id_diag_make_raw_msdu_start(
+		struct ath11k_base *ab, struct sk_buff *skb,
+		const struct ath11k_qcn6122_rx_id_snapshot *snap, u64 host_rx_ns,
+		char *raw, size_t raw_len)
+{
+	struct hal_rx_desc_qcn9074 *desc;
+	__le32 words[9];
+	unsigned long data, end;
+	u32 tag;
+	int len;
+
+	if (!ab || !skb || !snap || !raw ||
+	    ab->hw_params.hw_rev != ATH11K_HW_QCN6122 ||
+	    ab->hw_params.hal_desc_sz != sizeof(*desc) ||
+	    !snap->geometry_valid || !snap->bounds_valid ||
+	    !snap->info3_valid ||
+	    !(snap->software_role_match_mask &
+	      ATH11K_QCN6122_RX_ID_ROLE_MSDU_START) ||
+	    sizeof(desc->msdu_start) != sizeof(words))
+		return false;
+
+	data = (unsigned long)skb->data;
+	end = (unsigned long)skb_end_pointer(skb);
+	if (end < data || end - data < sizeof(*desc))
+		return false;
+	desc = (struct hal_rx_desc_qcn9074 *)skb->data;
+	tag = le32_to_cpu(desc->msdu_start_tag);
+	if (FIELD_GET(HAL_TLV_HDR_TAG, tag) != HAL_RX_MSDU_START ||
+	    FIELD_GET(HAL_TLV_HDR_LEN, tag) != sizeof(words))
+		return false;
+
+	memcpy(words, &desc->msdu_start, sizeof(words));
+	len = scnprintf(raw, raw_len,
+		 "qcn6122-rx-identity stage=reo-msdu-start mac=%u host_rx_ns=%llu msdu_start_ppdu=%u tag_id=%u tag_raw=0x%08x tag_len=%u tag_offset=%u start_offset=%u raw_len=%u attention_role_required=%u attention_info1_valid=%u attention_info1=0x%08x first_mpdu=%u w0=%08x w1=%08x w2=%08x w3=%08x w4=%08x w5=%08x w6=%08x w7=%08x w8=%08x\n",
+		 ATH11K_SKB_RXCB(skb)->mac_id,
+		 (unsigned long long)host_rx_ns,
+		 le16_to_cpu(desc->msdu_start.phy_ppdu_id),
+		 (u32)FIELD_GET(HAL_TLV_HDR_TAG, tag), tag,
+		 (u32)FIELD_GET(HAL_TLV_HDR_LEN, tag),
+		 (u32)offsetof(struct hal_rx_desc_qcn9074, msdu_start_tag),
+		 (u32)offsetof(struct hal_rx_desc_qcn9074, msdu_start),
+		 (u32)sizeof(words),
+		 !ATH11K_SKB_RXCB(skb)->is_continuation,
+		 snap->attention_info1_valid,
+		 snap->attention_info1,
+		 snap->attention_info1_valid &&
+		 !!(snap->attention_info1 & RX_ATTENTION_INFO1_FIRST_MPDU),
+		 le32_to_cpu(words[0]), le32_to_cpu(words[1]),
+		 le32_to_cpu(words[2]), le32_to_cpu(words[3]), le32_to_cpu(words[4]),
+		 le32_to_cpu(words[5]), le32_to_cpu(words[6]), le32_to_cpu(words[7]),
+		 le32_to_cpu(words[8]));
+	return len > 0 && len < raw_len - 1;
+}
