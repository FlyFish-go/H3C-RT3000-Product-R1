+/* Review-only helper proposal for frozen RT3000-C 618 dp_rx.c. */
+#ifdef CPTCFG_ATH11K_RT3000_MON_OWNER_DIAG
+#define ATH11K_QCN6122_RX_ID_QUOTA_CONTROL 4
+#define ATH11K_QCN6122_RX_ID_QUOTA_ISSUE 16
+#define ATH11K_QCN6122_RX_ID_MAX_REO_OBSERVATIONS 4096
+#define ATH11K_QCN6122_RX_ID_MAX_PENDING_REO_LOGS \
+	(ATH11K_QCN6122_RX_ID_QUOTA_ISSUE + ATH11K_QCN6122_RX_ID_QUOTA_CONTROL)
+#define ATH11K_QCN6122_RX_ID_LOG_LEN 896
+#define ATH11K_QCN6122_RX_ID_WINDOW (30 * HZ)
+#define ATH11K_QCN6122_RX_ID_ROLE_MSDU_END BIT(0)
+#define ATH11K_QCN6122_RX_ID_ROLE_ATTENTION BIT(1)
+#define ATH11K_QCN6122_RX_ID_ROLE_MSDU_START BIT(2)
+#define ATH11K_QCN6122_RX_ID_ROLE_MPDU_START BIT(3)
+#define ATH11K_QCN6122_RX_ID_ROLE_MPDU_END BIT(4)
+#define ATH11K_QCN6122_RX_ID_ROLE_ALL GENMASK(4, 0)
+
+enum ath11k_qcn6122_rx_id_stage {
+	ATH11K_QCN6122_RX_ID_REO,
+	ATH11K_QCN6122_RX_ID_PROCESS,
+};
+
+struct ath11k_qcn6122_rx_id_snapshot {
+	u32 tags[5];
+	u16 tag_ids[5];
+	u32 info3;
+	u8 software_role_match_mask;
+	bool geometry_valid;
+	bool bounds_valid;
+	bool info3_valid;
+	bool msdu_done_valid;
+	bool msdu_done;
+};
+
+static bool ath11k_qcn6122_rx_id_diag_enable;
+static unsigned long ath11k_qcn6122_rx_id_deadline;
+static atomic_t ath11k_qcn6122_rx_id_observations =
+	ATOMIC_INIT(ATH11K_QCN6122_RX_ID_MAX_REO_OBSERVATIONS);
+static DEFINE_SPINLOCK(ath11k_qcn6122_rx_id_diag_lock);
+static bool ath11k_qcn6122_rx_id_stop_logged;
+static bool ath11k_qcn6122_rx_id_stop_pending;
+static const char *ath11k_qcn6122_rx_id_stop_reason;
+static int ath11k_qcn6122_rx_id_stop_reo_issue;
+static int ath11k_qcn6122_rx_id_stop_reo_control;
+static int ath11k_qcn6122_rx_id_stop_process_issue;
+static int ath11k_qcn6122_rx_id_stop_process_control;
+static u64 ath11k_qcn6122_rx_id_stop_host_rx_ns;
+static char ath11k_qcn6122_rx_id_pending_reo_logs[
+	ATH11K_QCN6122_RX_ID_MAX_PENDING_REO_LOGS][ATH11K_QCN6122_RX_ID_LOG_LEN];
+static u8 ath11k_qcn6122_rx_id_pending_head;
+static u8 ath11k_qcn6122_rx_id_pending_count;
+static atomic_t ath11k_qcn6122_rx_id_reo_issue =
+	ATOMIC_INIT(ATH11K_QCN6122_RX_ID_QUOTA_ISSUE);
+static atomic_t ath11k_qcn6122_rx_id_reo_control =
+	ATOMIC_INIT(ATH11K_QCN6122_RX_ID_QUOTA_CONTROL);
+static atomic_t ath11k_qcn6122_rx_id_process_issue =
+	ATOMIC_INIT(ATH11K_QCN6122_RX_ID_QUOTA_ISSUE);
+static atomic_t ath11k_qcn6122_rx_id_process_control =
+	ATOMIC_INIT(ATH11K_QCN6122_RX_ID_QUOTA_CONTROL);
+static atomic_t ath11k_qcn6122_rx_id_reo_issue_total = ATOMIC_INIT(0);
+static atomic_t ath11k_qcn6122_rx_id_reo_control_total = ATOMIC_INIT(0);
+static atomic_t ath11k_qcn6122_rx_id_process_issue_total = ATOMIC_INIT(0);
+static atomic_t ath11k_qcn6122_rx_id_process_control_total = ATOMIC_INIT(0);
+
+static void ath11k_qcn6122_rx_id_diag_stop(const char *reason)
+{
+	unsigned long flags;
+
+	/* Claim stop and snapshot totals; callers emit after releasing RX locks. */
+	spin_lock_irqsave(&ath11k_qcn6122_rx_id_diag_lock, flags);
+	if (!ath11k_qcn6122_rx_id_stop_logged) {
+		ath11k_qcn6122_rx_id_stop_logged = true;
+		WRITE_ONCE(ath11k_qcn6122_rx_id_diag_enable, false);
+		ath11k_qcn6122_rx_id_stop_reason = reason;
+		ath11k_qcn6122_rx_id_stop_host_rx_ns = ktime_get_ns();
+		ath11k_qcn6122_rx_id_stop_reo_issue =
+			atomic_read(&ath11k_qcn6122_rx_id_reo_issue_total);
+		ath11k_qcn6122_rx_id_stop_reo_control =
+			atomic_read(&ath11k_qcn6122_rx_id_reo_control_total);
+		ath11k_qcn6122_rx_id_stop_process_issue =
+			atomic_read(&ath11k_qcn6122_rx_id_process_issue_total);
+		ath11k_qcn6122_rx_id_stop_process_control =
+			atomic_read(&ath11k_qcn6122_rx_id_process_control_total);
+		ath11k_qcn6122_rx_id_stop_pending = true;
+	}
+	spin_unlock_irqrestore(&ath11k_qcn6122_rx_id_diag_lock, flags);
+}
+
+static void ath11k_qcn6122_rx_id_diag_emit_stop(struct ath11k_base *ab)
+{
+	unsigned long flags;
+	const char *reason = NULL;
+	int reo_issue, reo_control, process_issue, process_control;
+	u64 host_rx_ns = 0;
+
+	spin_lock_irqsave(&ath11k_qcn6122_rx_id_diag_lock, flags);
+	if (ath11k_qcn6122_rx_id_stop_pending) {
+		ath11k_qcn6122_rx_id_stop_pending = false;
+		reason = ath11k_qcn6122_rx_id_stop_reason;
+		reo_issue = ath11k_qcn6122_rx_id_stop_reo_issue;
+		reo_control = ath11k_qcn6122_rx_id_stop_reo_control;
+		process_issue = ath11k_qcn6122_rx_id_stop_process_issue;
+		process_control = ath11k_qcn6122_rx_id_stop_process_control;
+		host_rx_ns = ath11k_qcn6122_rx_id_stop_host_rx_ns;
+	}
+	spin_unlock_irqrestore(&ath11k_qcn6122_rx_id_diag_lock, flags);
+	if (reason)
+		dev_info(ab->dev,
+			 "qcn6122-rx-identity stage=stop reason=%s host_rx_ns=%llu reo_issue=%d reo_control=%d process_issue=%d process_control=%d\n",
+			 reason, (unsigned long long)host_rx_ns, reo_issue, reo_control,
+			 process_issue, process_control);
+}
+
+static void ath11k_qcn6122_rx_id_diag_queue_reo(const char *fmt, ...)
+{
+	va_list args;
+	unsigned long flags;
+	u8 index;
+
+	spin_lock_irqsave(&ath11k_qcn6122_rx_id_diag_lock, flags);
+	if (ath11k_qcn6122_rx_id_pending_count <
+	    ATH11K_QCN6122_RX_ID_MAX_PENDING_REO_LOGS) {
+		index = (ath11k_qcn6122_rx_id_pending_head +
+			 ath11k_qcn6122_rx_id_pending_count) %
+			ATH11K_QCN6122_RX_ID_MAX_PENDING_REO_LOGS;
+		va_start(args, fmt);
+		vsnprintf(ath11k_qcn6122_rx_id_pending_reo_logs[index],
+			 ATH11K_QCN6122_RX_ID_LOG_LEN, fmt, args);
+		va_end(args);
+		ath11k_qcn6122_rx_id_pending_count++;
+	}
+	spin_unlock_irqrestore(&ath11k_qcn6122_rx_id_diag_lock, flags);
+}
+
+static void ath11k_qcn6122_rx_id_diag_emit_reo(struct ath11k_base *ab)
+{
+	char log[ATH11K_QCN6122_RX_ID_LOG_LEN];
+	unsigned long flags;
+	u8 head;
+
+	for (;;) {
+		spin_lock_irqsave(&ath11k_qcn6122_rx_id_diag_lock, flags);
+		if (!ath11k_qcn6122_rx_id_pending_count) {
+			spin_unlock_irqrestore(&ath11k_qcn6122_rx_id_diag_lock,
+					       flags);
+			break;
+		}
+		head = ath11k_qcn6122_rx_id_pending_head;
+		strscpy(log, ath11k_qcn6122_rx_id_pending_reo_logs[head],
+			sizeof(log));
+		ath11k_qcn6122_rx_id_pending_head =
+			(head + 1) % ATH11K_QCN6122_RX_ID_MAX_PENDING_REO_LOGS;
+		ath11k_qcn6122_rx_id_pending_count--;
+		spin_unlock_irqrestore(&ath11k_qcn6122_rx_id_diag_lock, flags);
+		dev_info(ab->dev, "%s", log);
+	}
+}
+
+static int ath11k_qcn6122_rx_id_diag_set(const char *val,
+					 const struct kernel_param *kp)
+{
+	bool enable;
+	int ret;
+
+	ret = kstrtobool(val, &enable);
+	if (ret)
+		return ret;
+	{
+		unsigned long flags;
+
+		spin_lock_irqsave(&ath11k_qcn6122_rx_id_diag_lock, flags);
+		if (enable && !ath11k_qcn6122_rx_id_diag_enable) {
+			atomic_set(&ath11k_qcn6122_rx_id_observations,
+				   ATH11K_QCN6122_RX_ID_MAX_REO_OBSERVATIONS);
+			ath11k_qcn6122_rx_id_stop_logged = false;
+			ath11k_qcn6122_rx_id_stop_pending = false;
+			ath11k_qcn6122_rx_id_pending_head = 0;
+			ath11k_qcn6122_rx_id_pending_count = 0;
+			atomic_set(&ath11k_qcn6122_rx_id_reo_issue,
+				   ATH11K_QCN6122_RX_ID_QUOTA_ISSUE);
+			atomic_set(&ath11k_qcn6122_rx_id_reo_control,
+				   ATH11K_QCN6122_RX_ID_QUOTA_CONTROL);
+			atomic_set(&ath11k_qcn6122_rx_id_process_issue,
+				   ATH11K_QCN6122_RX_ID_QUOTA_ISSUE);
+			atomic_set(&ath11k_qcn6122_rx_id_process_control,
+				   ATH11K_QCN6122_RX_ID_QUOTA_CONTROL);
+			atomic_set(&ath11k_qcn6122_rx_id_reo_issue_total, 0);
+			atomic_set(&ath11k_qcn6122_rx_id_reo_control_total, 0);
+			atomic_set(&ath11k_qcn6122_rx_id_process_issue_total, 0);
+			atomic_set(&ath11k_qcn6122_rx_id_process_control_total, 0);
+			WRITE_ONCE(ath11k_qcn6122_rx_id_deadline, jiffies +
+				   ATH11K_QCN6122_RX_ID_WINDOW);
+		}
+		WRITE_ONCE(*(bool *)kp->arg, enable);
+		spin_unlock_irqrestore(&ath11k_qcn6122_rx_id_diag_lock, flags);
+	}
+	return 0;
+}
+
+static const struct kernel_param_ops ath11k_qcn6122_rx_id_diag_ops = {
+	.set = ath11k_qcn6122_rx_id_diag_set,
+	.get = param_get_bool,
+};
+module_param_cb(qcn6122_rx_identity_diag,
+		&ath11k_qcn6122_rx_id_diag_ops,
+		&ath11k_qcn6122_rx_id_diag_enable, 0600);
+MODULE_PARM_DESC(qcn6122_rx_identity_diag,
+		 "Bounded C/QCN6122 RX descriptor identity diagnostic");
+
+static bool ath11k_qcn6122_rx_id_diag_target(struct ath11k_base *ab)
+{
+	if (!READ_ONCE(ath11k_qcn6122_rx_id_diag_enable) || !ab)
+		return false;
+	if (ab->hw_params.hw_rev != ATH11K_HW_QCN6122 ||
+	    !of_machine_is_compatible("h3c,rt3000-rtl8367s"))
+		return false;
+	if (time_after_eq(jiffies,
+			  READ_ONCE(ath11k_qcn6122_rx_id_deadline))) {
+		ath11k_qcn6122_rx_id_diag_stop("30-second-window");
+		return false;
+	}
+	return true;
+}
+
+/* Called once per REO entry. Stops before diagnostics can exceed the cap. */
+static bool ath11k_qcn6122_rx_id_diag_observe(struct ath11k_base *ab)
+{
+	int remaining;
+
+	if (!READ_ONCE(ath11k_qcn6122_rx_id_diag_enable) || !ab)
+		return false;
+	if (ab->hw_params.hw_rev != ATH11K_HW_QCN6122 ||
+	    !of_machine_is_compatible("h3c,rt3000-rtl8367s"))
+		return false;
+	/* Called from the REO destination-ring critical section. */
+	if (time_after_eq(jiffies,
+			  READ_ONCE(ath11k_qcn6122_rx_id_deadline))) {
+		ath11k_qcn6122_rx_id_diag_stop("30-second-window");
+		return false;
+	}
+	remaining = atomic_dec_if_positive(
+		&ath11k_qcn6122_rx_id_observations);
+	if (remaining < 0) {
+		ath11k_qcn6122_rx_id_diag_stop("reo-observation-cap");
+		return false;
+	}
+	return true;
+}
+
+static bool ath11k_qcn6122_rx_id_diag_take(
+		struct ath11k_base *ab, enum ath11k_qcn6122_rx_id_stage stage,
+		bool issue)
+{
+	atomic_t *left, *total;
+	int remaining;
+
+	if (!ath11k_qcn6122_rx_id_diag_target(ab))
+		return false;
+	if (stage == ATH11K_QCN6122_RX_ID_REO) {
+		left = issue ? &ath11k_qcn6122_rx_id_reo_issue :
+			       &ath11k_qcn6122_rx_id_reo_control;
+		total = issue ? &ath11k_qcn6122_rx_id_reo_issue_total :
+				 &ath11k_qcn6122_rx_id_reo_control_total;
+	} else {
+		left = issue ? &ath11k_qcn6122_rx_id_process_issue :
+			       &ath11k_qcn6122_rx_id_process_control;
+		total = issue ? &ath11k_qcn6122_rx_id_process_issue_total :
+				 &ath11k_qcn6122_rx_id_process_control_total;
+	}
+	remaining = atomic_dec_if_positive(left);
+	if (remaining >= 0)
+		atomic_inc(total);
+	return remaining >= 0;
+}
+
+/* Snapshot descriptor bytes only; the skb payload is never read. */
+static void ath11k_qcn6122_rx_id_diag_snapshot(
+		struct ath11k_base *ab, struct sk_buff *skb,
+		struct ath11k_qcn6122_rx_id_snapshot *snap)
+{
+	struct hal_rx_desc_qcn9074 *desc;
+	struct rx_attention *attention;
+	unsigned long head, data, end;
+	static const u16 expected[5] = {
+		HAL_RX_MSDU_END, HAL_RX_ATTENTION, HAL_RX_MSDU_START,
+		HAL_RX_MPDU_START, HAL_RX_MPDU_END,
+	};
+	int i;
+
+	memset(snap, 0, sizeof(*snap));
+	if (!ath11k_qcn6122_rx_id_diag_target(ab) || !skb)
+		return;
+	head = (unsigned long)skb->head;
+	data = (unsigned long)skb->data;
+	end = (unsigned long)skb_end_pointer(skb);
+	if (end < head || data < head || data > end)
+		return;
+	snap->geometry_valid = true;
+	if (ab->hw_params.hal_desc_sz != sizeof(*desc) ||
+	    sizeof(*desc) > end - data)
+		return;
+	snap->bounds_valid = true;
+	desc = (struct hal_rx_desc_qcn9074 *)skb->data;
+	snap->tags[0] = le32_to_cpu(desc->msdu_end_tag);
+	snap->tags[1] = le32_to_cpu(desc->rx_attn_tag);
+	snap->tags[2] = le32_to_cpu(desc->msdu_start_tag);
+	snap->tags[3] = le32_to_cpu(desc->mpdu_start_tag);
+	snap->tags[4] = le32_to_cpu(desc->mpdu_end_tag);
+	for (i = 0; i < ARRAY_SIZE(expected); i++) {
+		snap->tag_ids[i] = FIELD_GET(HAL_TLV_HDR_TAG, snap->tags[i]);
+		if (snap->tag_ids[i] == expected[i])
+			snap->software_role_match_mask |= BIT(i);
+	}
+	if (snap->software_role_match_mask & ATH11K_QCN6122_RX_ID_ROLE_MSDU_START) {
+		snap->info3 = le32_to_cpu(desc->msdu_start.info3);
+		snap->info3_valid = true;
+	}
+	if (snap->software_role_match_mask & ATH11K_QCN6122_RX_ID_ROLE_ATTENTION) {
+		attention = ath11k_dp_rx_get_attention(ab,
+							 (struct hal_rx_desc *)skb->data);
+		if (attention) {
+			snap->msdu_done = ath11k_dp_rx_h_attn_msdu_done(attention);
+			snap->msdu_done_valid = true;
+		}
+	}
+}
+
+/* A continuation requests no TLV role; boundary roles follow REO flags. */
+static u8 ath11k_qcn6122_rx_id_diag_requested(bool first, bool last,
+					       bool is_first_msdu,
+					       bool is_last_msdu,
+					       bool continuation)
+{
+	u8 requested = 0;
+
+	if (continuation)
+		return 0;
+	if (first)
+		requested |= ATH11K_QCN6122_RX_ID_ROLE_MSDU_START;
+	if (last)
+		requested |= ATH11K_QCN6122_RX_ID_ROLE_MSDU_END |
+			     ATH11K_QCN6122_RX_ID_ROLE_ATTENTION;
+	if (first && is_first_msdu)
+		requested |= ATH11K_QCN6122_RX_ID_ROLE_MPDU_START;
+	if (last && is_last_msdu)
+		requested |= ATH11K_QCN6122_RX_ID_ROLE_MPDU_END;
+	return requested;
+}
+#endif /* CPTCFG_ATH11K_RT3000_MON_OWNER_DIAG */
