+/* Bounded, default-off C machine RX descriptor observation. */
+static bool ath11k_ipq5018_rx_layout_diag_enable;
+module_param_named(ipq5018_rx_layout_diag, ath11k_ipq5018_rx_layout_diag_enable,
+		   bool, 0600);
+MODULE_PARM_DESC(ipq5018_rx_layout_diag,
+		 "C RT3000 IPQ5018 bounded RX layout diagnostic");
+static atomic_t ath11k_ipq5018_rx_layout_ring_bad = ATOMIC_INIT(16);
+static atomic_t ath11k_ipq5018_rx_layout_ring_ok = ATOMIC_INIT(4);
+static atomic_t ath11k_ipq5018_rx_layout_process_bad = ATOMIC_INIT(16);
+static atomic_t ath11k_ipq5018_rx_layout_process_ok = ATOMIC_INIT(4);
+
+#define ATH11K_RX_LAYOUT_TAG_MSDU_END	BIT(0)
+#define ATH11K_RX_LAYOUT_TAG_ATTENTION	BIT(1)
+#define ATH11K_RX_LAYOUT_TAG_MSDU_START	BIT(2)
+#define ATH11K_RX_LAYOUT_TAG_MPDU_START	BIT(3)
+#define ATH11K_RX_LAYOUT_TAG_MPDU_END	BIT(4)
+#define ATH11K_RX_LAYOUT_TAG_ALL	GENMASK(4, 0)
+
+struct ath11k_rx_layout_snapshot {
+	u32 data_off;
+	u32 tail_off;
+	u32 end_off;
+	u32 len;
+	u32 tags[5];
+	u16 tag_ids[5];
+	u8 tag_match_mask;
+	bool geometry_valid;
+	bool bounds_valid;
+};
+
+static bool ath11k_ipq5018_rx_layout_diag_target(struct ath11k_base *ab)
+{
+	return READ_ONCE(ath11k_ipq5018_rx_layout_diag_enable) && ab &&
+	       ab->hw_params.hw_rev == ATH11K_HW_IPQ5018 &&
+	       of_machine_is_compatible("h3c,rt3000-rtl8367s");
+}
+
+static bool ath11k_rx_layout_take(atomic_t *left)
+{
+	int old = atomic_read(left);
+
+	while (old > 0) {
+		if (atomic_cmpxchg(left, old, old - 1) == old)
+			return true;
+		old = atomic_read(left);
+	}
+	return false;
+}
+
+static u8 ath11k_ipq5018_rx_layout_requested_mask(bool first, bool last,
+						   bool first_msdu,
+						   bool last_msdu)
+{
+	u8 requested = 0;
+
+	if (first)
+		requested |= ATH11K_RX_LAYOUT_TAG_MSDU_START;
+	if (last)
+		requested |= ATH11K_RX_LAYOUT_TAG_MSDU_END |
+			     ATH11K_RX_LAYOUT_TAG_ATTENTION;
+	if (first && first_msdu)
+		requested |= ATH11K_RX_LAYOUT_TAG_MPDU_START;
+	if (last && last_msdu)
+		requested |= ATH11K_RX_LAYOUT_TAG_MPDU_END;
+
+	return requested;
+}
+
+static void ath11k_ipq5018_rx_layout_snapshot(struct ath11k_base *ab,
+					      struct sk_buff *skb,
+					      struct ath11k_rx_layout_snapshot *snap)
+{
+	struct hal_rx_desc_qcn9074 *qdesc;
+	unsigned long head, data, tail, end;
+	static const u16 expected[5] = {
+		HAL_RX_MSDU_END, HAL_RX_ATTENTION, HAL_RX_MSDU_START,
+		HAL_RX_MPDU_START, HAL_RX_MPDU_END,
+	};
+	int i;
+
+	memset(snap, 0, sizeof(*snap));
+	if (!ab || ab->hw_params.hw_rev != ATH11K_HW_IPQ5018 || !skb)
+		return;
+	head = (unsigned long)skb->head;
+	data = (unsigned long)skb->data;
+	tail = (unsigned long)skb_tail_pointer(skb);
+	end = (unsigned long)skb_end_pointer(skb);
+	if (end < head || data < head || data > end || tail < data || tail > end)
+		return;
+	snap->geometry_valid = true;
+	snap->data_off = data - head;
+	snap->tail_off = tail - head;
+	snap->end_off = end - head;
+	snap->len = skb->len;
+	qdesc = (struct hal_rx_desc_qcn9074 *)skb->data;
+	if (ab->hw_params.hal_desc_sz != sizeof(*qdesc) ||
+	    sizeof(*qdesc) > end - data)
+		return;
+	snap->bounds_valid = true;
+	snap->tags[0] = le32_to_cpu(qdesc->msdu_end_tag);
+	snap->tags[1] = le32_to_cpu(qdesc->rx_attn_tag);
+	snap->tags[2] = le32_to_cpu(qdesc->msdu_start_tag);
+	snap->tags[3] = le32_to_cpu(qdesc->mpdu_start_tag);
+	snap->tags[4] = le32_to_cpu(qdesc->mpdu_end_tag);
+	for (i = 0; i < ARRAY_SIZE(expected); i++) {
+		snap->tag_ids[i] = (u16)FIELD_GET(HAL_TLV_HDR_TAG, snap->tags[i]);
+		if (snap->tag_ids[i] == expected[i])
+			snap->tag_match_mask |= BIT(i);
+	}
+}
+
+static bool ath11k_ipq5018_rx_layout_tags_valid(
+		const struct ath11k_rx_layout_snapshot *snap, u8 requested)
+{
+	return snap->bounds_valid && requested &&
+	       (snap->tag_match_mask & requested) == requested;
+}
