--- a/drivers/net/wireless/ath/ath11k/dp_tx.c
+++ b/drivers/net/wireless/ath/ath11k/dp_tx.c
@@ -10,6 +10,106 @@
 #include "hw.h"
 #include "peer.h"
 
+#ifdef CPTCFG_ATH11K_RT3000_TX_UNKNOWN_DIAG
+#include <linux/module.h>
+#include <linux/of.h>
+
+#define ATH11K_RT3000_TX_UNKNOWN_MAX_SAMPLES 32
+
+static bool ath11k_rt3000_tx_unknown_diag;
+static atomic_t ath11k_rt3000_tx_unknown_samples = ATOMIC_INIT(0);
+
+static int ath11k_rt3000_tx_unknown_diag_set(const char *val,
+					     const struct kernel_param *kp)
+{
+	bool enable;
+	int ret;
+
+	ret = kstrtobool(val, &enable);
+	if (ret)
+		return ret;
+
+	ret = param_set_bool(val, kp);
+	if (!ret && enable)
+		atomic_set(&ath11k_rt3000_tx_unknown_samples, 0);
+
+	return ret;
+}
+
+static const struct kernel_param_ops ath11k_rt3000_tx_unknown_diag_ops = {
+	.set = ath11k_rt3000_tx_unknown_diag_set,
+	.get = param_get_bool,
+};
+module_param_cb(tx_unknown_msdu_diag,
+		&ath11k_rt3000_tx_unknown_diag_ops,
+		&ath11k_rt3000_tx_unknown_diag, 0600);
+MODULE_PARM_DESC(tx_unknown_msdu_diag,
+		 "Enable bounded RT3000 C unknown-TX-completion observations");
+
+static int ath11k_rt3000_tx_unknown_diag_take_sample(void)
+{
+	int old;
+
+	for (;;) {
+		old = atomic_read(&ath11k_rt3000_tx_unknown_samples);
+		if (old >= ATH11K_RT3000_TX_UNKNOWN_MAX_SAMPLES)
+			return 0;
+		if (atomic_cmpxchg(&ath11k_rt3000_tx_unknown_samples,
+				   old, old + 1) == old)
+			return old + 1;
+	}
+}
+
+static bool ath11k_rt3000_tx_unknown_diag_allowed(struct ath11k_base *ab)
+{
+	u32 board_id = READ_ONCE(ab->qmi.target.board_id);
+
+	return READ_ONCE(ath11k_rt3000_tx_unknown_diag) &&
+	       of_machine_is_compatible("h3c,rt3000-rtl8367s") &&
+	       ((ab->hw_rev == ATH11K_HW_IPQ5018 && board_id == 0x23) ||
+		(ab->hw_rev == ATH11K_HW_QCN6122 && board_id == 0xb0));
+}
+
+static void
+ath11k_rt3000_tx_unknown_diag_log(struct ath11k_base *ab, const char *path,
+				  int ring_id, u8 mac_id, u32 cookie,
+				  u32 msdu_id,
+				  enum hal_wbm_rel_src_module rel_src,
+				  enum hal_wbm_htt_tx_comp_status fw_status,
+				  struct dp_tx_ring *tx_ring,
+				  const struct hal_wbm_release_ring *desc)
+{
+	const u32 *words = (const u32 *)desc;
+	int sample, slot_id = -1;
+	bool slot_bit = false, slot_buf = false;
+
+	if (!ath11k_rt3000_tx_unknown_diag_allowed(ab))
+		return;
+
+	sample = ath11k_rt3000_tx_unknown_diag_take_sample();
+	if (!sample)
+		return;
+
+	BUILD_BUG_ON(sizeof(*desc) != 8 * sizeof(u32));
+	if (msdu_id < DP_TX_IDR_SIZE) {
+		slot_id = READ_ONCE(tx_ring->idr_pool[msdu_id].id);
+		slot_bit = test_bit(msdu_id, tx_ring->idrs);
+		slot_buf = !!READ_ONCE(tx_ring->idr_pool[msdu_id].buf);
+	}
+
+	ath11k_warn(ab,
+		    "tx unknown diag n=%d path=%s ring=%d mac=%u cookie=%08x "
+		    "msdu=%u rel=%u fw_status=%u "
+		    "wbm=%08x,%08x,%08x,%08x,%08x,%08x,%08x,%08x "
+		    "slot_id=%d slot_bit=%u slot_buf=%u\n",
+		    sample, path, ring_id, (unsigned int)mac_id, cookie, msdu_id,
+		    (unsigned int)rel_src, (unsigned int)fw_status,
+		    words[0], words[1], words[2], words[3], words[4], words[5],
+		    words[6], words[7], slot_id,
+		    (unsigned int)slot_bit, (unsigned int)slot_buf);
+}
+#endif
