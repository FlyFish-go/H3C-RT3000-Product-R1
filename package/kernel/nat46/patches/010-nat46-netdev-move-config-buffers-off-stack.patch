O1b: nat46_remove() move config buffers off the kernel stack

The function used two VLAs of the local constant buflen=1024. Under the
QSDK arm kernel global -Werror (arch/arm/Makefile) these trigger
-Werror=vla, and their fixed-stack form trips -Werror=frame-larger-than.
Allocate one contiguous 2*buflen block instead; both buffers keep the
identical 1024-byte capacity and simultaneous lifetime. Caller context
is nat46_proc_write() (process context), so GFP_KERNEL is legal.
--- a/nat46/modules/nat46-netdev.c
+++ b/nat46/modules/nat46-netdev.c
@@ -254,7 +254,8 @@
 int nat46_remove(char *devname, char *buf) {
 	int ret = -1;
 	int buflen = 1024;
-	char config_remove[buflen];
+	char *config_remove; /* O1b: moved off kernel stack, see alloc below */
+	char *config;
 	struct net_device *dev;
 	nat46_instance_t *nat46;
 	nat46_instance_t *nat46_remove;
@@ -267,14 +268,24 @@
 		return ret;
 	}
 
+	/* O1b: one contiguous block, two logical bufs of the existing
+	 * compile-time bound buflen(1024) each; caller context is
+	 * nat46_proc_write() => process context, GFP_KERNEL is legal */
+	config_remove = kmalloc(2 * buflen, GFP_KERNEL);
+	if(!config_remove) {
+		release_nat46_instance(nat46_remove);
+		return ret;
+	}
+	config = config_remove + buflen;
+
 	if(nat46_set_ipair_config(nat46_remove, 0, buf, buflen) < 0) {
+		kfree(config_remove);
 		release_nat46_instance(nat46_remove);
 		return ret;
 	}
 
 	result_rem = nat46_get_ipair_config(nat46_remove, 0, config_remove, buflen);
 	for(i = 0; i < nat46->npairs; i++) {
-		char config[buflen];
 		int result = nat46_get_ipair_config(nat46, i, config, buflen);
 
 		if (result_rem == result && strncmp(config_remove, config, result_rem) == 0) {
@@ -288,6 +299,7 @@
 			break;
 		}
 	}
+	kfree(config_remove);
 	release_nat46_instance(nat46_remove);
 	return ret;
 }
