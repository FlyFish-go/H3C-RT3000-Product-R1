msgid "%s (via router)"
msgstr "%s（通过路由器）"

msgid "%s (via this browser)"
msgstr "%s（通过本浏览器）"

msgid "12 hours"
msgstr "12 小时"

msgid "24 hours"
msgstr "24 小时"

msgid "3 days"
msgstr "3 天"

msgid "6 hours"
msgstr "6 小时"

msgid "7 days"
msgstr "7 天"

msgid "Automatic (whichever site works)"
msgstr "自动（哪个能连用哪个）"

msgid "Automatic check"
msgstr "自动检测"

msgid "Cancel"
msgstr "取消"

msgid "Release notes"
msgstr "更新内容"

msgid "Check automatically"
msgstr "自动检测更新"

msgid "Check for updates"
msgstr "检查更新"

msgid "Check from this browser:"
msgstr "本浏览器检测结果："

msgid "Check interval (hours)"
msgstr "检测间隔（小时）"

msgid "Checking for updates…"
msgstr "正在检查更新…"

msgid "Checks for new H3C Magic releases. The image is downloaded and verified on the router, and nothing is installed without your confirmation."
msgstr "检查 H3C Magic 新版本。固件由路由器下载并校验，未经你确认不会安装。"

msgid "Could not reach the update servers. Check the internet connection and try again."
msgstr "无法连接更新服务器，请检查网络后重试。"

msgid "Details"
msgstr "详情"

msgid "Discard"
msgstr "丢弃"

msgid "Do not power off the router during the upgrade. It takes about 3 to 5 minutes."
msgstr "升级过程中请勿断电，大约需要 3 到 5 分钟。"

msgid "Download %s (%s)"
msgstr "下载 %s（%s）"

msgid "Download failed: %s"
msgstr "下载失败：%s"

msgid "Download site"
msgstr "下载站点"

msgid "Downloaded and verified: %s (%s)."
msgstr "已下载并校验：%s（%s）。"

msgid "Downloading from %s…"
msgstr "正在从 %s 下载…"

msgid "Firmware"
msgstr "固件"

msgid "Firmware Update"
msgstr "固件更新"

msgid "Gitee (mainland China)"
msgstr "Gitee（中国大陆）"

msgid "Grant access to firmware update check and install"
msgstr "允许检查与安装固件更新"

msgid "Hardware group"
msgstr "硬件分组"

msgid "Install"
msgstr "安装"

msgid "Install %s"
msgstr "安装 %s"

msgid "Install failed: %s"
msgstr "安装失败：%s"

msgid "Installing…"
msgstr "正在安装…"

msgid "Install…"
msgstr "安装…"

msgid "Keep current settings"
msgstr "保留当前设置"

msgid "Last check from the router: %s (%s)"
msgstr "路由器上次检测：%s（%s）"

msgid "New firmware %s is available."
msgstr "发现新固件 %s。"

msgid "New version available:"
msgstr "发现新版本："

msgid "No release list has been published yet."
msgstr "尚未发布版本清单。"

msgid "Not checked yet."
msgstr "尚未检查更新。"

msgid "OK, signature valid"
msgstr "正常，签名有效"

msgid "Off by default. When on, the router checks for new releases at the interval below. It never installs anything by itself."
msgstr "默认关闭。开启后，路由器按下面的间隔检查新版本，只提示，不会自动安装。"

msgid "Online Update"
msgstr "在线更新"

msgid "Online update is not available for this hardware group yet. Flash new firmware manually instead."
msgstr "此硬件分组暂不支持在线更新，请手动刷写固件。"

msgid "Release list from"
msgstr "版本清单来源"

msgid "Release page"
msgstr "发布页"

msgid "Settings of %s cannot be carried over to %s. The router will start with default settings at 192.168.10.1."
msgstr "%s 的设置无法带到 %s，升级后路由器将恢复默认设置，地址为 192.168.10.1。"

msgid "The downloaded image has been checked (size, SHA-256 and sysupgrade image test). It is written to the system slot the router is running from now. The other slot is not touched, so you can still boot it from the U-Boot rescue page if anything goes wrong."
msgstr "下载的固件已通过校验（大小、SHA-256 和 sysupgrade 镜像检查）。它会写入当前正在运行的系统槽，另一个系统槽不受影响；万一出问题，仍可在 U-Boot 救援页里从另一个槽启动。"

msgid "The system is flashing now.<br /> DO NOT POWER OFF THE DEVICE!<br /> Wait a few minutes before you try to reconnect. It might be necessary to renew the address of your computer to reach the device again, depending on your settings."
msgstr "正在刷写固件。<br />请勿断开设备电源！<br />请等待几分钟后再尝试重新连接。根据你的设置，可能需要让电脑重新获取地址才能再次访问路由器。"

msgid "This router runs the latest release (checked %s)."
msgstr "已是最新版本（检查于 %s）。"

msgid "This router runs the latest release."
msgstr "当前已是最新版本。"

msgid "View update"
msgstr "查看更新"

msgid "automatic"
msgstr "自动"

msgid "cannot connect"
msgstr "无法连接"

msgid "manual"
msgstr "手动"

msgid "no release list published yet"
msgstr "尚未发布版本清单"

msgid "not supported yet"
msgstr "暂不支持"

msgid "signature check failed"
msgstr "签名校验失败"

msgid "timed out"
msgstr "超时"

msgid "unknown error"
msgstr "未知错误"

msgid "wrong or damaged release list"
msgstr "版本清单错误或损坏"
