 	     opt;
 		 opt = strtok(NULL, " ")) {
 
-		if ((val = get_option(opt, "channel=")))
+		if ((val = get_option(opt, "channel="))) {
 			conf->channel = atoi(val);
-		else if ((val = get_option(opt, "ht_capab=")))
+			chan_set = 1;
+		} else if ((val = get_option(opt, "ht_capab=")))
 			conf->ht_capab = atoi(val);
 		else if ((val = get_option(opt, "ht_capab_mask=")))
 			conf->ht_capab &= atoi(val);
@@ -172,6 +241,9 @@ static struct hostapd_config *hostapd_ct
 			break;
 	}
 
