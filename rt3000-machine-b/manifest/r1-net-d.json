  "authoritative_root_cause": {
    "class": "MISSING_NON_FORCE_PORT_CLOCK_PROGRAMMING",
    "statement": "Machine-B WAN = SSDK port 1 / GMAC0 / PHY-managed non-force port. The MP adapter bound ssdk_port_speed_clock_set() to `force_port == A_TRUE`, so GMAC0's speed clock was never programmed; the RCG stayed on xo / 24 MHz, and every 1000BASE-T frame failed CRC.",
    "proven_by": "R1-PROBE-I live trace (rt3000-close-work/evidence/R1_PROBE_I_TRACE_RUN_20260919/)",
    "rejected_hypotheses": [
      "state-aliasing / NET-C first-apply guard (refuted on hardware)",
      "missing DTS clocks / clock-names (refuted)",
      "qcom,link-poll (refuted)",
      "rx-page-mode (refuted)",
      "EEE (refuted)",
      "hardware / BOM / PCB (refuted by OEM same-hardware control)"
    ]
  },
  "acceptance_criterion": {
    "clock": "read gmac0_rx_clk_src and gmac0_tx_clk_src parent + effective rate",
    "forbidden": "do NOT use gephy_gcc_tx enable_count as a pass/fail gate - it is a software shadow clock with no .enable op"
  },
