+
+	/* MDIO1 (to the external QCA8337).  Without this pinmux the bus
+	 * cannot clock and every mdio@90000 transaction returns 0x0000.
+	 * Values are from the QSDK reference board DTS. */
+	mdio1_pins: mdio1_pins {
+		mux_0 {
+			pins = "gpio36";
+			function = "mdc";
+			drive-strength = <8>;
+			bias-pull-up;
+		};
+
+		mux_1 {
+			pins = "gpio37";
+			function = "mdio";
+			drive-strength = <8>;
