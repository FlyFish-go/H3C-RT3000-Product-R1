diff --git a/target/linux/ipq50xx/base-files/etc/board.d/02_network b/target/linux/ipq50xx/base-files/etc/board.d/02_network
index 39f5014..843e3a4 100755
--- a/target/linux/ipq50xx/base-files/etc/board.d/02_network
+++ b/target/linux/ipq50xx/base-files/etc/board.d/02_network
@@ -25,13 +25,20 @@ ipq50xx_setup_interfaces()
 				"1:wan"
 			;;
 		h3c,rt3000)
-			# RT3000 front panel (frozen G4C1 evidence):
-			# LAN1=switch port2, LAN2=port3, LAN3=port4,
-			# WAN rides the internal GE PHY path (eth0), CPU=port6
+			# Machine-B two-switch model (Probe B/E evidence).
+			#
+			#   internal switch0 (QCA MP, 3 ports): port1 -> eth0 (WAN jack),
+			#                                      port2 -> eth1 (LAN CPU port)
+			#   external switch1 (QCA8337, MDIO):  port6t CPU uplink -> eth1,
+			#                                      ports 2 3 4 = the LAN jacks
+			#
+			# The external switch is a port-expander with VLANs DISABLED,
+			# matching the OEM /etc/config/network evidence.  The previous
+			# single 6-port VLAN model was disproven by Probes A/B/E.
+			ucidef_set_interfaces_lan_wan "eth1" "eth0"
 			ucidef_add_switch "switch1" \
-				"6u@eth1" "5u@eth0" \
-				"2:lan:1" "3:lan:2" "4:lan:3" \
-				"1:wan"
+				"6u@eth1" \
+				"2:lan:1" "3:lan:2" "4:lan:3"
 			;;
 	esac
 }
