+/* RT3000 C fail-closed physical NAND policy.  This is deliberately machine
+ * scoped and validates the complete child map before registering any child.
+ */
+#define RT3000_C_NAND_SIZE 0x08000000ULL
+#define RT3000_C_SLOT0_OFF 0x00900000ULL
+#define RT3000_C_SLOT1_OFF 0x03100000ULL
+#define RT3000_C_SLOT_SIZE 0x02800000ULL
+#define RT3000_C_INSTALLER_BC_PROP "h3c,rt3000-c-installer-write-bootconfig"
+#define RT3000_C_SAFE_PROP "h3c,rt3000-native-nand-safe-config"
+
+static bool rt3000_c_nand(struct mtd_info *mtd)
+{
+	return mtd->type == MTD_NANDFLASH &&
+		of_machine_is_compatible("h3c,rt3000-rtl8367s");
+}
+
+static bool rt3000_c_installer_write_bc(struct mtd_info *mtd)
+{
+	struct device_node *np = mtd->dev.parent ? mtd->dev.parent->of_node : NULL;
+
+	return np && of_property_read_bool(np, RT3000_C_INSTALLER_BC_PROP);
+}
+
+static bool rt3000_c_nand_safe_node(struct mtd_info *mtd)
+{
+	struct device_node *np = mtd->dev.parent ? mtd->dev.parent->of_node : NULL;
+
+	return np && of_property_read_bool(np, RT3000_C_SAFE_PROP);
+}
+
+static bool rt3000_c_partition_map_valid(struct mtd_info *master,
+					 const struct mtd_partition *parts,
+					 int count)
+{
+	static const struct { u64 off, size; } expected[] = {
+		{0x00000000,0x00080000},{0x00080000,0x00080000},
+		{0x00100000,0x00040000},{0x00140000,0x00040000},
+		{0x00180000,0x00100000},{0x00280000,0x00100000},
+		{0x00380000,0x00040000},{0x003c0000,0x00040000},
+		{0x00400000,0x00040000},{0x00440000,0x00040000},
+		{0x00480000,0x00080000},{0x00500000,0x00140000},
+		{0x00640000,0x00140000},{0x00780000,0x00100000},
+		{0x00880000,0x00080000},{0x00900000,0x02800000},
+		{0x03100000,0x02800000},{0x05900000,0x00600000},
+		{0x05f00000,0x00600000},{0x06500000,0x00100000},
+		{0x06600000,0x01700000},
+	};
+	bool seen[ARRAY_SIZE(expected)] = { false };
+	int i;
+	unsigned int j;
+
+	if (mtd_is_partition(master) || master->size != RT3000_C_NAND_SIZE ||
+	    master->writesize != 2048 || master->erasesize != 131072 ||
+	    master->oobsize != 64 || master->ecc_strength != 4 ||
+	    !rt3000_c_nand_safe_node(master) ||
+	    count != (int)ARRAY_SIZE(expected) || !parts)
+		return false;
+
+	for (i = 0; i < count; i++) {
+		if (parts[i].size == 0 || !parts[i].name)
+			return false;
+		for (j = 0; j < ARRAY_SIZE(expected); j++) {
+			if ((u64)parts[i].offset == expected[j].off &&
+			    (u64)parts[i].size == expected[j].size)
+				break;
+		}
+		if (j == ARRAY_SIZE(expected) || seen[j])
+			return false;
+		seen[j] = true;
+	}
+	for (i = 0; i < (int)ARRAY_SIZE(expected); i++)
+		if (!seen[i])
+			return false;
+	return true;
+}
+
+static bool rt3000_c_write_window(u64 off, u64 size, bool installer)
+{
+	if (off == RT3000_C_SLOT1_OFF && size == RT3000_C_SLOT_SIZE)
+		return true;
+	return installer &&
+		((off == 0x00100000 && size == 0x00040000) ||
+		 (off == 0x00140000 && size == 0x00040000));
+}
