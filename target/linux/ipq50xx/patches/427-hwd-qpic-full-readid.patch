+static void hwd_nand_capture_raw_id(struct nand_id *id, u32 raw_id)
+{
+	id->data[0] = raw_id & 0xff;
+	id->data[1] = (raw_id >> 8) & 0xff;
+	id->data[2] = (raw_id >> 16) & 0xff;
+	id->data[3] = (raw_id >> 24) & 0xff;
+	id->len = sizeof(raw_id);
+}
