From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Thu, 24 Sep 2026 00:00:00 +0800
Subject: [PATCH] net: phy: qca-mdio: select C MDIO1 CTRL_0 values

Keep the QSDK defaults for all controllers except the physical MDIO1
resource on the IPQ5018 H3C boards (C and RW3000 HW-A). The alternate
values are historical C6 observations; HW-A cannot read the QCA8337
chip ID over MDIO1 at the default divider.

---
 drivers/net/phy/mdio-qca.c | 26 +++++++++++++++++++-------
 1 file changed, 21 insertions(+), 7 deletions(-)

--- a/drivers/net/phy/mdio-qca.c
+++ b/drivers/net/phy/mdio-qca.c
@@ -39,6 +39,11 @@
 #define MDIO_CTRL_4_ACCESS_CODE_C45_READ	2
 #define CTRL_0_REG_DEFAULT_VALUE	0x1500F
 #define CTRL_0_REG_C45_DEFAULT_VALUE	0x1510F
+#define MDIO1_PHYS_BASE			0x90000
+#define CTRL_0_REG_MDIO1_VALUE		0x1502F
+#define CTRL_0_REG_C45_MDIO1_VALUE	0x1512F
+#define RT3000_C_COMPAT			"h3c,rt3000-rtl8367s"
+#define RW3000_HW_A_COMPAT		"h3c,rw3000-hw-a"
 
 #define QCA_MDIO_RETRY	1000
 #define QCA_MDIO_DELAY	10
@@ -56,6 +61,8 @@
 	struct clk *mdio_clk;
 	void __iomem *membase;
 	int phy_irq[PHY_MAX_ADDR];
+	u32 ctrl0_val;
+	u32 ctrl0_c45_val;
 };
 
 static int qca_mdio_wait_busy(struct qca_mdio_data *am)
@@ -91,8 +98,7 @@
 		unsigned int mmd = (regnum >> 16) & 0x1F;
 		unsigned int reg = regnum & 0xFFFF;
 
-		writel(CTRL_0_REG_C45_DEFAULT_VALUE,
-		       am->membase + MDIO_CTRL_0_REG);
+		writel(am->ctrl0_c45_val, am->membase + MDIO_CTRL_0_REG);
 		/* issue the phy address and mmd */
 		writel((mii_id << 8) | mmd, am->membase + MDIO_CTRL_1_REG);
 		/* issue reg */
@@ -100,7 +106,7 @@
 		cmd = MDIO_CTRL_4_ACCESS_START |
 			MDIO_CTRL_4_ACCESS_CODE_C45_ADDR;
 	} else {
-		writel(CTRL_0_REG_DEFAULT_VALUE, am->membase + MDIO_CTRL_0_REG);
+		writel(am->ctrl0_val, am->membase + MDIO_CTRL_0_REG);
 		/* issue the phy address and reg */
 		writel((mii_id << 8) | regnum, am->membase + MDIO_CTRL_1_REG);
 		cmd = MDIO_CTRL_4_ACCESS_START | MDIO_CTRL_4_ACCESS_CODE_READ;
@@ -140,8 +146,7 @@
 		unsigned int mmd = (regnum >> 16) & 0x1F;
 		unsigned int reg = regnum & 0xFFFF;
 
-		writel(CTRL_0_REG_C45_DEFAULT_VALUE,
-		       am->membase + MDIO_CTRL_0_REG);
+		writel(am->ctrl0_c45_val, am->membase + MDIO_CTRL_0_REG);
 		/* issue the phy address and mmd */
 		writel((mii_id << 8) | mmd, am->membase + MDIO_CTRL_1_REG);
 		/* issue reg */
@@ -152,7 +157,7 @@
 		if (qca_mdio_wait_busy(am))
 			return -ETIMEDOUT;
 	} else {
-		writel(CTRL_0_REG_DEFAULT_VALUE, am->membase + MDIO_CTRL_0_REG);
+		writel(am->ctrl0_val, am->membase + MDIO_CTRL_0_REG);
 		/* issue the phy address and reg */
 		writel((mii_id << 8) | regnum, am->membase + MDIO_CTRL_1_REG);
 	}
@@ -287,6 +292,15 @@
 		goto err_disable_clk;
 	}
 
+	am->ctrl0_val = CTRL_0_REG_DEFAULT_VALUE;
+	am->ctrl0_c45_val = CTRL_0_REG_C45_DEFAULT_VALUE;
+	if (res->start == MDIO1_PHYS_BASE &&
+	    (of_machine_is_compatible(RT3000_C_COMPAT) ||
+	     of_machine_is_compatible(RW3000_HW_A_COMPAT))) {
+		am->ctrl0_val = CTRL_0_REG_MDIO1_VALUE;
+		am->ctrl0_c45_val = CTRL_0_REG_C45_MDIO1_VALUE;
+	}
+
 	am->membase = devm_ioremap_resource(&pdev->dev, res);
 	if (!am->membase) {
 		dev_err(&pdev->dev, "unable to ioremap registers\n");
@@ -300,7 +314,7 @@
 		goto err_disable_clk;
 	}
 
-	writel(CTRL_0_REG_DEFAULT_VALUE, am->membase + MDIO_CTRL_0_REG);
+	writel(am->ctrl0_val, am->membase + MDIO_CTRL_0_REG);
 
 	am->mii_bus->name = "qca_mdio";
 	am->mii_bus->read = &qca_mdio_read;
--
2.40.1
