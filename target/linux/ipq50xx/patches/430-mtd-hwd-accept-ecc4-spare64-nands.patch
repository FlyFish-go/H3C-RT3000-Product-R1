From: FlyFish-go <2541290956@qq.com>
Subject: [PATCH] mtd: hw-d: accept every ECC4/spare64 NAND U-Boot supports

Patch 427 only accepted the Winbond W25N01GWZEIG (EF:BA:21), so HW-D
units with another NAND reset before mounting rootfs, although U-Boot's
NAND catalog already drives them. Accept the 128 MiB / page2048 /
erase131072 / OOB64 / ECC4 parts that U-Boot lists with this geometry and
that nand_ids.c describes the same way:

  c8:11 ESMT F50D1G41LB(2M)   (QPIC reads c8:11:7f:7f)
  c8:21 GigaDevice GD5F1GQ5REYIH
  c8:c9 GigaDevice GD5F1GQ4RE9IH
  c2:92 Macronix MX35UF1GE4AC
  ef:bc Winbond W25N01JW

The geometry checks are unchanged, so spare128 or ECC8 parts are still
rejected. Also print the ID that was actually accepted.

---
--- a/drivers/mtd/nand/raw/qcom_nandc.c
+++ b/drivers/mtd/nand/raw/qcom_nandc.c
@@ -3646,10 +3646,34 @@
 }
 static DEVICE_ATTR_RO(hwd_nand_id);
 
+/*
+ * HW-D ships with several 128 MiB / page2048 / OOB64 / ECC4 serial NANDs.
+ * Accept the ones that U-Boot's NAND catalog drives with this geometry and
+ * that nand_ids.c describes the same way; the caller still checks the
+ * geometry. Parts with spare128 or ECC8 need a different layout and stay
+ * rejected.
+ */
 static bool hwd_nand_jedec_valid(const struct nand_id *id)
 {
-	return id->len >= 3 && id->data[0] == 0xef &&
-	       id->data[1] == 0xba && id->data[2] == 0x21;
+	static const u8 ecc4_spare64[][2] = {
+		{ 0xc8, 0x11 },	/* ESMT F50D1G41LB(2M); QPIC reads c8:11:7f:7f */
+		{ 0xc8, 0x21 },	/* GigaDevice GD5F1GQ5REYIH */
+		{ 0xc8, 0xc9 },	/* GigaDevice GD5F1GQ4RE9IH */
+		{ 0xc2, 0x92 },	/* Macronix MX35UF1GE4AC */
+		{ 0xef, 0xbc },	/* Winbond W25N01JW */
+	};
+	unsigned int i;
+
+	if (id->len < 3)
+		return false;
+	/* Winbond W25N01GWZEIG */
+	if (id->data[0] == 0xef && id->data[1] == 0xba && id->data[2] == 0x21)
+		return true;
+	for (i = 0; i < ARRAY_SIZE(ecc4_spare64); i++)
+		if (id->data[0] == ecc4_spare64[i][0] &&
+		    id->data[1] == ecc4_spare64[i][1])
+			return true;
+	return false;
 }
 
 static int qcom_nand_host_init_and_register(struct qcom_nand_controller *nandc,
@@ -3776,7 +3800,10 @@
 			nand_cleanup(chip);
 			return -ENODEV;
 		}
-		dev_info(dev, "HW-D NAND JEDEC EF:BA:21, 128MiB, page2048, erase131072, OOB64, ECC4; x1/no-write-probe\n");
+		dev_info(dev, "HW-D NAND JEDEC %02X:%02X:%02X, 128MiB, page2048, erase131072, OOB64, ECC4; x1/no-write-probe\n",
+			 nandc->hwd_nand_id.data[0],
+			 nandc->hwd_nand_id.data[1],
+			 nandc->hwd_nand_id.data[2]);
 	}
 
 	if (c_mtd_discovery || c_native_safe || hwd_native_safe)
