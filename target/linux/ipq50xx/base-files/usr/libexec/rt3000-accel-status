#!/bin/sh
# H3C Magic - NSS acceleration status as JSON for LuCI.
ECM=/sys/kernel/debug/ecm
num() { local v; v="$(cat "$1" 2>/dev/null)"; case "$v" in ''|*[!0-9]*) echo 0;; *) echo "$v";; esac; }
loaded=false; [ -d "$ECM" ] && loaded=true
paused="$(cat /var/run/rt3000-accel.paused 2>/dev/null)"
enabled="$(uci -q get ecm.global.enabled)"; [ "$enabled" = 0 ] || enabled=1
printf '{"loaded":%s,"enabled":%s,"paused":"%s","connections":%s,"accelerated_ipv4":%s,"accelerated_ipv6":%s}\n' \
	"$loaded" "$([ "$enabled" = 1 ] && echo true || echo false)" "$paused" \
	"$(num $ECM/ecm_db/connection_count)" \
	"$(num $ECM/ecm_nss_ipv4/accelerated_count)" \
	"$(num $ECM/ecm_nss_ipv6/accelerated_count)"
