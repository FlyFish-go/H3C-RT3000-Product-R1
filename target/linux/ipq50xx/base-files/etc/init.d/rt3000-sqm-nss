#!/bin/sh /etc/rc.common
# H3C Magic - pause NSS acceleration while SQM is enabled.
#
# SQM shapes traffic in the Linux qdisc layer. Flows accelerated by NSS
# (through ECM) never reach that layer, so with acceleration running SQM
# would shape almost nothing. While any SQM queue is enabled, stop ECM
# from accelerating new flows and defunct the accelerated ones; when all
# queues are disabled again, resume acceleration. The ECM module stays
# loaded. Only acceleration that this service paused is resumed.

START=99
USE_PROCD=1

ECM=/sys/kernel/debug/ecm
MARK=/var/run/rt3000-sqm-nss.paused

sqm_queue_enabled() {
	local enabled
	config_get_bool enabled "$1" enabled 0
	[ "$enabled" = 1 ] && sqm_on=1
}

apply() {
	local f

	[ -d "$ECM" ] || return 0
	sqm_on=0
	[ -f /etc/config/sqm ] && {
		config_load sqm
		config_foreach sqm_queue_enabled queue
	}

	if [ "$sqm_on" = 1 ]; then
		[ -e "$MARK" ] && return 0
		for f in "$ECM/front_end_ipv4_stop" "$ECM/front_end_ipv6_stop"; do
			[ -e "$f" ] && echo 1 > "$f"
		done
		[ -e "$ECM/ecm_db/defunct_all" ] && echo 1 > "$ECM/ecm_db/defunct_all"
		touch "$MARK"
		logger -t rt3000-sqm-nss "SQM enabled: NSS acceleration paused"
	elif [ -e "$MARK" ]; then
		for f in "$ECM/front_end_ipv4_stop" "$ECM/front_end_ipv6_stop"; do
			[ -e "$f" ] && echo 0 > "$f"
		done
		rm -f "$MARK"
		logger -t rt3000-sqm-nss "SQM disabled: NSS acceleration resumed"
	fi
}

start_service() {
	apply
}

reload_service() {
	apply
}

service_triggers() {
	procd_add_reload_trigger "sqm"
}
