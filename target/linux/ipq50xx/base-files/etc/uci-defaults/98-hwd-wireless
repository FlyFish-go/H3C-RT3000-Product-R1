#!/bin/sh
# Exact D factory MACs; determine radio identity by detected band, never index.
[ "$(board_name)" = "h3c,nx30-hw-d" ] || exit 0
. /lib/functions.sh
. /lib/rt3000/wifi-c.sh
hwd_macs="$(/usr/sbin/hwd-factory-mac)" || exit 1
set -- $hwd_macs
[ "$#" -eq 4 ] || exit 1
hwd_mac_2g="$3"
hwd_mac_5g="$4"

hwd_device() {
	local band
	config_get band "$1" band
	case "$band" in
		2g) hwd_seen_2g=$((hwd_seen_2g+1)); hwd_radio_2g="$1";;
		5g) hwd_seen_5g=$((hwd_seen_5g+1)); hwd_radio_5g="$1";;
		*) hwd_error=1;;
	esac
}
hwd_iface() {
	local device band
	# Only generated default interfaces receive the factory addresses.
	case "$1" in default_radio*) ;; *) return;; esac
	config_get device "$1" device
	config_get band "$device" band
	case "$band" in
		2g) hwd_if_2g=$((hwd_if_2g+1)); hwd_section_2g="$1";;
		5g) hwd_if_5g=$((hwd_if_5g+1)); hwd_section_5g="$1";;
		*) hwd_error=1; return;;
	esac
}
# Firmware probes and normal mac80211 hotplug detection are asynchronous.
# Wait for their complete generated config, without starting a second detector.
hwd_wait=0
while :; do
	set -- /sys/class/ieee80211/phy*
	[ "$#" -le 2 ] || exit 1
	hwd_seen_2g=0; hwd_seen_5g=0; hwd_if_2g=0; hwd_if_5g=0; hwd_error=0
	config_load wireless
	config_foreach hwd_device wifi-device
	config_foreach hwd_iface wifi-iface
	if [ "$#" -eq 2 ] && [ -d "$1" ] && [ -d "$2" ] &&
	   [ "$hwd_seen_2g" -eq 1 ] && [ "$hwd_seen_5g" -eq 1 ] &&
	   [ "$hwd_if_2g" -eq 1 ] && [ "$hwd_if_5g" -eq 1 ] && [ "$hwd_error" -eq 0 ]; then
		break
	fi
	[ "$hwd_wait" -lt 45 ] || {
		logger -t hwd-factory-mac 'two PHYs and complete default interfaces not ready; retry retained'
		exit 1
	}
	hwd_wait=$((hwd_wait + 1))
	sleep 1
done
# uci-defaults also runs after a keep-settings sysupgrade: convert only the
# untouched mac80211 template (radio disabled, SSID OpenWrt, no encryption),
# otherwise just give an AP without an address its factory MAC.
hwd_apply() {
	local radio="$1" iface="$2" ssid="$3" mac="$4" htmode="$5"

	if [ "$(uci -q get "wireless.$radio.disabled")" = "1" ] &&
	   [ "$(uci -q get "wireless.$iface.ssid")" = "OpenWrt" ] &&
	   [ "$(uci -q get "wireless.$iface.encryption")" = "none" ]; then
		uci -q set "wireless.$iface.macaddr=$mac" &&
		uci -q set "wireless.$iface.ssid=$ssid" &&
		uci -q set "wireless.$iface.encryption=psk2" &&
		uci -q set "wireless.$iface.key=$RT3000_WIFI_DEFAULT_KEY" &&
		uci -q set "wireless.$iface.disabled=0" &&
		uci -q set "wireless.$radio.htmode=$htmode" &&
		uci -q set "wireless.$radio.disabled=0" &&
		# ath11k wiphys are self-managed; without a country the firmware
		# default (US) stays in force. NX30 is a CN-market unit.
		uci -q set "wireless.$radio.country=CN" || return 1
	elif [ -z "$(uci -q get "wireless.$iface.macaddr")" ]; then
		uci -q set "wireless.$iface.macaddr=$mac" || return 1
	fi
	return 0
}
hwd_apply "$hwd_radio_2g" "$hwd_section_2g" "$RT3000_WIFI_SSID_2G" "$hwd_mac_2g" HE20 || exit 1
hwd_apply "$hwd_radio_5g" "$hwd_section_5g" "$RT3000_WIFI_SSID_5G" "$hwd_mac_5g" HE80 || exit 1
uci -q commit wireless
