// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * Exact-device HW-D profile: NX30, IPQ5000, W25N01GWZEIG EF:BA:21.
 * Uses QSDK 11.5 IPQ5018/ath11k bindings, with only same-device OEM facts
 * ported after fresh FDT and switch inspection. The WPS key is modelled
 * from the same-device OEM FDT (tlmm gpio38, KEY_WPS_BUTTON, active-low,
 * 60 ms debounce). No LED pin has OEM evidence, so LEDs stay unmodelled
 * rather than guessed.
 * The installed D U-Boot accepts the OEM-shaped config@mp02.1 FIT route;
 * therefore rootfs extent/label nodes are intentionally absent. Linux owns
 * the explicit physical A/B map through the early storage-bootargs hook.
 */

/dts-v1/;

#include "ipq5018.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>

/ {
	model = "H3C Magic NX30 HW-D";
	compatible = "h3c,nx30-hw-d", "qcom,ipq5018-mp02.1", "qcom,ipq5018";

	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&intc>;

	aliases {
		serial0 = &blsp1_uart1;

		ethernet0 = &mac0;
		ethernet1 = &mac1;
	};

	/* WPS key, straight from the same-device OEM FDT: tlmm gpio38,
	 * active-low, 60 ms debounce, EV_KEY/KEY_WPS_BUTTON.  The OEM key
	 * node carries pinctrl-0 -> button_pins; that group is reproduced
	 * below as wps_button_pins. */
	gpio_keys {
		compatible = "gpio-keys";
		pinctrl-0 = <&wps_button_pins>;
		pinctrl-names = "default";

		button@1 {
			label = "wps";
			linux,code = <KEY_WPS_BUTTON>;
			linux,input-type = <EV_KEY>;
			gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};

	/* Physical NOR is absent on this NAND board. D U-Boot requires this
	 * exact disabled compatibility stub when it fixes up an OEM FIT. */
	soc {
		spi@78b5000 {
			compatible = "qcom,spi-qup-v2.2.1";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
			m25p80@0 {
				compatible = "n25q128a11";
				reg = <0>;
				status = "disabled";
			};
		};
	};

	chosen {
		bootargs-append = " swiotlb=1 loglevel=3";
		/* Applied after removing inherited storage selectors; ECC/console stay. */
		h3c,storage-bootargs = "mtdparts=qcom_nand.0:0x80000@0(0:SBL1)ro,0x80000@0x80000(0:MIBIB)ro,0x40000@0x100000(0:BOOTCONFIG)ro,0x40000@0x140000(0:BOOTCONFIG1)ro,0x100000@0x180000(0:QSEE)ro,0x100000@0x280000(0:QSEE_1)ro,0x40000@0x380000(0:DEVCFG)ro,0x40000@0x3c0000(0:DEVCFG_1)ro,0x40000@0x400000(0:CDT)ro,0x40000@0x440000(0:CDT_1)ro,0x80000@0x480000(0:APPSBLENV)ro,0x140000@0x500000(0:APPSBL)ro,0x140000@0x640000(0:APPSBL_1)ro,0x100000@0x780000(0:ART)ro,0x80000@0x880000(0:TRAINING)ro,0x2800000@0x900000(rootfs),0x2800000@0x3100000(oem_rootfs)ro,0x600000@0x5900000(pdt_data)ro,0x600000@0x5f00000(pdt_data_1)ro,0x100000@0x6500000(exp)ro,0x1700000@0x6600000(plugin)ro ubi.mtd=rootfs ubi.block=0,1 root=/dev/ubiblock0_1 rootfstype=squashfs rootwait";
		stdout-path = "serial0:115200n8";
	};


	/* HW-D has 256 MiB integrated RAM (fresh same-device OEM FDT); state it explicitly so a RAM
	 * FIT is independent of what OEM U-Boot passes in the FDT. */
	memory {
		device_type = "memory";
		reg = <0x0 0x40000000 0x0 0x10000000>;
	};

	reserved-memory {
		q6_mem_regions: q6_mem_regions@4b000000 {
			no-map;
#ifndef CONFIG_ATH11K_MEM_PROFILE_256M
			reg = <0x0 0x4b000000 0x0 0x3b00000>;
#else
			reg = <0x0 0x4b000000 0x0 0x4500000>;
#endif
		};
	};
};

&tmc_etr {
	/delete-property/ memory-region;
};

&tlmm {
	blsp_uart0_pins: blsp_uart0_pins {
		pins =
			"gpio28", // RX
			"gpio29"; // TX
		function = "blsp0_uart1";
		drive-strength = <8>;
		bias-disable;
	};

	qspi_nand_pins: qspi_nand_pins {
		clock {
			pins = "gpio9";
			function = "qspi_clk";
			drive-strength = <8>;
			bias-disable;
		};

		cs {
			pins = "gpio8";
			function = "qspi_cs";
			drive-strength = <8>;
			bias-disable;
		};

		data {
			pins = "gpio7", "gpio6", "gpio5", "gpio4";
			function = "qspi_data";
			drive-strength = <8>;
			bias-disable;
		};
	};


	/* MDIO1 (to the external QCA8337).  Without this pinmux the bus
	 * cannot clock and every mdio@90000 transaction returns 0x0000.
	 * Values match the fresh same-device OEM FDT. */
	mdio1_pins: mdio1_pins {
		mux_0 {
			pins = "gpio36";
			function = "mdc";
			drive-strength = <8>;
			bias-pull-up;
		};

		mux_1 {
			pins = "gpio37";
			function = "mdio";
			drive-strength = <8>;
			bias-pull-up;
		};
	};

	/* OEM button_pins group: the WPS pin is also biased up in the pin
	 * configuration, so keep the same drive-strength/bias rather than
	 * relying on the gpio-keys active-low flag alone. */
	wps_button_pins: wps_button_pins {
		pins = "gpio38";
		function = "gpio";
		drive-strength = <8>;
		bias-pull-up;
	};

};

&blsp1_uart1 {
	pinctrl-0 = <&blsp_uart0_pins>;
	pinctrl-names = "default";
	status = "ok";
};

&qpic_bam {
	status = "ok";
};

&nand {
	h3c,nx30-hw-d-nand-safe-config;
	pinctrl-0 = <&qspi_nand_pins>;
	pinctrl-names = "default";
	status = "ok";

	nandcs@0 {
		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "0:SBL1";
				reg = <0x000000 0x080000>;
				read-only;
			};
			partition@80000 {
				label = "0:MIBIB";
				reg = <0x080000 0x080000>;
				read-only;
			};
			partition@100000 {
				label = "0:BOOTCONFIG";
				reg = <0x100000 0x040000>;
			};
			partition@140000 {
				label = "0:BOOTCONFIG1";
				reg = <0x140000 0x040000>;
			};
			partition@180000 {
				label = "0:QSEE";
				reg = <0x180000 0x100000>;
				read-only;
			};
			partition@280000 {
				label = "0:QSEE_1";
				reg = <0x280000 0x100000>;
				read-only;
			};
			partition@380000 {
				label = "0:DEVCFG";
				reg = <0x380000 0x040000>;
				read-only;
			};
			partition@3c0000 {
				label = "0:DEVCFG_1";
				reg = <0x3c0000 0x040000>;
				read-only;
			};
			partition@400000 {
				label = "0:CDT";
				reg = <0x400000 0x040000>;
				read-only;
			};
			partition@440000 {
				label = "0:CDT_1";
				reg = <0x440000 0x040000>;
				read-only;
			};
			partition@480000 {
				label = "0:APPSBLENV";
				reg = <0x480000 0x080000>;
				read-only;
			};
			partition@500000 {
				label = "0:APPSBL";
				reg = <0x500000 0x140000>;
				read-only;
			};
			partition@640000 {
				label = "0:APPSBL_1";
				reg = <0x640000 0x140000>;
				read-only;
			};
			partition@780000 {
				label = "0:ART";
				reg = <0x780000 0x100000>;
				read-only;
			};
			partition@880000 {
				label = "0:TRAINING";
				reg = <0x880000 0x080000>;
				read-only;
			};

			partition@5900000 {
				label = "pdt_data";
				reg = <0x5900000 0x00600000>;
				read-only;
			};
			partition@5f00000 {
				label = "pdt_data_1";
				reg = <0x5f00000 0x00600000>;
				read-only;
			};
			partition@6500000 {
				label = "exp";
				reg = <0x6500000 0x00100000>;
				read-only;
			};
			partition@6600000 {
				label = "plugin";
				reg = <0x6600000 0x01700000>;
				read-only;
			};
		};
	};
};

&soc {


	ess-instance {
		num_devices = <2>;

		/* Internal ESS (MAC0 side): WAN path via IPQ5018 GE PHY addr 7,
		 * MAC1 side forced to the QCA8337 SerDes. OEM-extracted values. */
		ess-switch@0x39c00000 {
			compatible = "qcom,ess-switch-ipq50xx";
			device_id = <0>;

			cmnblk_clk = "internal_96MHz";
			switch_mac_mode = <0xf>; /* PORT_WRAPPER_SGMII_CHANNEL0 */

			qcom,port_phyinfo {
				port@0 {
					port_id = <1>;

					mdiobus = <&mdio0>;
					phy_address = <7>;
				};

				port@1 {
					port_id = <2>;

					forced-speed = <1000>;
					forced-duplex = <1>;
				};
			};
		};

		/* External QCA8337 (HW-D hardware-validated live DTB):
		 * chip 0x1302, MDIO access, reset GPIO26 (AR8337 switch reset on HW-D),
		 * CPU bmp 0x40 (port6), LAN bmp 0x1c (ports 2,3,4 only; port1 unused and down),
		 * WAN bmp 0x0 (WAN jack rides the internal PHY path).
		 * qcom,port_phyinfo intentionally omitted: AR8337 LAN PHYs are
		 * managed by SSDK direct MDIO access (FIX-F1, frozen evidence). */
		ess-switch1@1 {
			compatible = "qcom,ess-switch-qca83xx";
			device_id = <1>;

			switch_access_mode = "mdio";
			mdio-bus = <&mdio1>;

			reset_gpio = <&tlmm 26 0>;

			qca,ar8327-initvals = <
				0x00004 0x7600000   /* PAD0_MODE */
				0x00008 0x1000000   /* PAD5_MODE */
				0x0000c 0x80        /* PAD6_MODE */
				0x00010 0x2613a0    /* PORT6 FORCE MODE */
				0x000e4 0xaa545     /* MAC_POWER_SEL */
				0x000e0 0xc74164de  /* SGMII_CTRL */
				0x0007c 0x4e        /* PORT0_STATUS */
				0x00094 0x4e        /* PORT6_STATUS */
			>;

			switch_cpu_bmp = <0x40>;
			switch_lan_bmp = <0x1c>;
			switch_wan_bmp = <0x0>;

			/* LAN PHYs live on the external switch: port_id 1-4 map to
			 * PHY addresses 0-3 on mdio1 (same-device OEM FDT port table). */
			qcom,port_phyinfo {
				port@0 {
					port_id = <1>;
					phy_address = <0>;
				};

				port@1 {
					port_id = <2>;
					phy_address = <1>;
				};

				port@2 {
					port_id = <3>;
					phy_address = <2>;
				};

				port@3 {
					port_id = <4>;
					phy_address = <3>;
				};
			};
		};
	};

	/* WAN: MAC0 -> internal GE PHY (addr 7 on mdio0) -> QCA8337 phy4/port5 */
	mac0: dp1 {
		compatible = "qcom,nss-dp";
		device_type = "network";
		qcom,id = <1>;

		reg = <0x39C00000 0x10000>;
		interrupts = <GIC_SPI 101 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_SNOC_GMAC0_AXI_CLK>;
		clock-names = "nss-snoc-gmac-axi-clk";

		qcom,mactype = <2>; // GMAC_HAL_TYPE_SYN_GMAC
		local-mac-address = [000000000000];
		mdio-bus = <&mdio0>;
		qcom,phy-mdio-addr = <7>;
		phy-mode = "sgmii";
		qcom,rx-page-mode = <0>;
	};

	/* LAN/CPU path: MAC1 ---SGMII---> QCA8337 port6 */
	mac1: dp2 {
		compatible = "qcom,nss-dp";
		device_type = "network";
		qcom,id = <2>;

		reg = <0x39D00000 0x10000>;
		interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
		clocks = <&gcc GCC_SNOC_GMAC1_AXI_CLK>;
		clock-names = "nss-snoc-gmac-axi-clk";

		qcom,mactype = <2>; // GMAC_HAL_TYPE_SYN_GMAC
		local-mac-address = [000000000000];
		phy-mode = "sgmii";
		qcom,rx-page-mode = <0>;
	};
};

&mdio0 {
	status = "ok";

	// IPQ5018 GE Phy (addr 7) -> QCA8337 Phy4
	ethernet-phy@0 {
		reg = <7>;
	};
};

&mdio1 {
	status = "ok";
	pinctrl-0 = <&mdio1_pins>;
	pinctrl-names = "default";

	/* External QCA8337 reset.  The qca-mdio driver (mdio-qca.c) consumes
	 * this in qca_phy_reset(), driven BEFORE of_mdiobus_register():
	 *   gpio_direction_output(gpio, 0)  -> assert  (100ms)
	 *   gpio_set_value(gpio, 1)         -> release (100ms)
	 * Value and GPIO number are taken from the HW-D OEM working DTB
	 * (/proc/device-tree/soc/mdio@90000/phy-reset-gpio = <&tlmm 26 0>). */
	phy-reset-gpio = <&tlmm 26 0>;

	/* Three external PHYs, matching the OEM working device tree
	 * (ethernet-phy@0, @1, @2) and the driver's QCA_MAX_PHY_RESET limit. */
	ethernet-phy@0 {
		reg = <0>;
	};

	ethernet-phy@1 {
		reg = <1>;
	};

	ethernet-phy@2 {
		reg = <2>;
	};
};

&q6v5_wcss {
	compatible = "qcom,ipq5018-q6-mpd";
	#address-cells = <1>;
	#size-cells = <1>;
	ranges;

	resets =
		<&gcc GCC_WCSSAON_RESET>,
		<&gcc GCC_WCSS_Q6_BCR>;
	reset-names =
		"wcss_aon_reset",
		"wcss_q6_reset";

	clocks =
		<&gcc GCC_Q6_AXIS_CLK>,
		<&gcc GCC_WCSS_ECAHB_CLK>,
		<&gcc GCC_Q6_AXIM_CLK>,
		<&gcc GCC_Q6_AXIM2_CLK>,
		<&gcc GCC_Q6_AHB_CLK>,
		<&gcc GCC_Q6_AHB_S_CLK>,
		<&gcc GCC_WCSS_AXI_S_CLK>;
	clock-names =
		"gcc_q6_axis_clk",
		"gcc_wcss_ecahb_clk",
		"gcc_q6_axim_clk",
		"gcc_q6_axim2_clk",
		"gcc_q6_ahb_clk",
		"gcc_q6_ahb_s_clk",
		"gcc_wcss_axi_s_clk";

	reg =
		<0x0cd00000 0x4040>,
		<0x1938000 0x8>,
		<0x193d204 0x4>;
	reg-names =
		"qdsp6",
		"tcsr-msip",
		"tcsr-q6";

	memory-region = <&q6_mem_regions>;

	qcom,rproc = <&q6v5_wcss>;
	firmware = "IPQ5018/q6_fw.mdt";

	qcom,bootargs_smem = <507>;
	/* OEM-extracted HW-D UserPD boot-args (fresh same-device OEM FDT):
	 * {type 0x1, len 4, pd_id 3, gpio 0x0f}, {type 0x2(PCIE1), len 4,
	 *  pd_id 2, gpio 0x12} -- differs from the AX3000 donor wiring. */
	boot-args = <0x1 0x4 0x3 0x0f 0x0 0x0>,
		    <0x2 0x4 0x2 0x1b 0x0 0x0>;

	status = "ok";

	// IPQ5018 internal 2.4G radio (AHB)
	q6_wcss_pd1: remoteproc_pd1@4ab000 {
		compatible = "qcom,ipq5018-wcss-ahb-mpd";

		resets =
			<&gcc GCC_WCSSAON_RESET>,
			<&gcc GCC_WCSS_BCR>,
			<&gcc GCC_CE_BCR>;
		reset-names =
			"wcss_aon_reset",
			"wcss_reset",
			"ce_reset";

		clocks =
			<&gcc GCC_WCSS_AHB_S_CLK>,
			<&gcc GCC_WCSS_ACMT_CLK>,
			<&gcc GCC_WCSS_AXI_M_CLK>;
		clock-names =
			"gcc_wcss_ahb_s_clk",
			"gcc_wcss_acmt_clk",
			"gcc_wcss_axi_m_clk";

		reg = <0x4ab000 0x20>;
		reg-names = "rmb";

		qcom,halt-regs = <&tcsr_q6_block 0xa000 0xd000 0x0>;

		interrupts-extended =
			<&wcss_smp2p_in 8 0>,
			<&wcss_smp2p_in 9 0>,
			<&wcss_smp2p_in 12 0>,
			<&wcss_smp2p_in 11 0>;
		interrupt-names =
			"fatal",
			"ready",
			"spawn-ack",
			"stop-ack";

		qcom,smem-states =
			<&wcss_smp2p_out 8>,
			<&wcss_smp2p_out 9>,
			<&wcss_smp2p_out 10>;
		qcom,smem-state-names =
			"shutdown",
			"stop",
			"spawn";

		firmware = "IPQ5018/q6_fw.mdt";
		m3_firmware = "IPQ5018/m3_fw.mdt";
	};

	// QCN6102 physical radio on PCIe1 (software family path: qcn6122)
	q6_wcss_pd2: remoteproc_pd2 {
		compatible = "qcom,ipq5018-wcss-pcie-mpd";

		interrupts-extended =
			<&wcss_smp2p_in 16 0>,
			<&wcss_smp2p_in 17 0>,
			<&wcss_smp2p_in 20 0>,
			<&wcss_smp2p_in 19 0>;
		interrupt-names =
			"fatal",
			"ready",
			"spawn-ack",
			"stop-ack";

		qcom,smem-states =
			<&wcss_smp2p_out 16>,
			<&wcss_smp2p_out 17>,
			<&wcss_smp2p_out 18>;
		qcom,smem-state-names =
			"shutdown",
			"stop",
			"spawn";

		firmware = "IPQ5018/q6_fw.mdt";
		m3_firmware = "qcn6122/m3_fw.mdt";
	};
};

&wifi0 {
	// IPQ5018 internal 2.4G
	// Internal low-priority radio; external QCN6102 is the high-priority 5G radio.
	nss-radio-priority = <0>;
	qcom,multipd_arch;
	qcom,rproc = <&q6_wcss_pd1>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd1";

	// HW-D OEM board_id (integrated radio)
	qcom,board_id = <0x10>;

	qcom,bdf-addr = <0x4c400000 0x4c400000 0x4c400000>;
	qcom,caldb-addr = <0 0 0>;
#ifndef CONFIG_ATH11K_MEM_PROFILE_256M
	m3-dump-addr = <0x4d400000>;
#else
	m3-dump-addr = <0x4d100000>;
#endif

	status = "ok";
};

&wifi1 {
	// QCN6102 physical radio (software driver family: qcn6122)
	// External high-priority 5G radio; IPQ5018 internal radio is low priority.
	nss-radio-priority = <1>;
	qcom,multipd_arch;
	qcom,rproc = <&q6_wcss_pd2>;
	qcom,userpd-subsys-name = "q6v5_wcss_userpd2";

	// HW-D OEM board_id (external radio)
	qcom,board_id = <0x60>;

	qcom,bdf-addr = <0x4d300000 0x4d300000 0x4d300000>;
	qcom,caldb-addr = <0 0 0>;
#ifndef CONFIG_ATH11K_MEM_PROFILE_256M
	m3-dump-addr = <0x4ea00000>;
#else
	m3-dump-addr = <0x4e200000>;
#endif

	status = "ok";
};

&wifi2 {
	status = "disabled";
};

&wifi3 {
	status = "disabled";
};
